{
  "meta": {
    "name": "strict",
    "label": "Strict Platform",
    "description": "Full SSDLC baseline with stricter image pinning and execution hygiene."
  },
  "required_controls": {
    "unit_tests": true,
    "coverage_report": true,
    "sast": true,
    "scan": true,
    "deploy_test": true
  },
  "test_environments": ["test", "qa", "stage", "staging", "dev", "sandbox", "review", "uat", "integration", "preprod", "preview"],
  "production_environments": ["prod", "production", "live"],
  "security_policies": {
    "forbid_latest_images": true,
    "forbid_unpinned_images": true,
    "forbid_allow_failure_on_security": true,
    "forbid_manual_test_deploy": true,
    "forbid_strict_host_key_bypass": true,
    "forbid_inline_secrets": true,
    "forbid_remote_script_piping": true
  }
}
