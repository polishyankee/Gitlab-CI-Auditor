<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>GitLab CI SSDLC Auditor</title>
    <style>
      :root {
        --bg: #0e1016;
        --bg-accent: #05070d;
        --panel: #151821;
        --panel-soft: #10131b;
        --border: #2f3442;
        --border-strong: #444d60;
        --ink: #dce3ea;
        --muted: #99a4b3;
        --orange: #fc6d26;
        --orange-strong: #e24329;
        --orange-soft: rgba(252, 109, 38, 0.16);
        --orange-soft-strong: rgba(252, 109, 38, 0.28);
        --amber: #fca326;
        --red: #f85149;
        --yellow: #d7a33e;
        --shadow: 0 28px 80px rgba(0, 0, 0, 0.45);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(252, 109, 38, 0.18), transparent 24%),
          radial-gradient(circle at top right, rgba(226, 67, 41, 0.16), transparent 28%),
          linear-gradient(180deg, rgba(21, 24, 33, 0.94), rgba(14, 16, 22, 1)),
          var(--bg);
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(18px);
        background: rgba(14, 16, 22, 0.88);
        border-bottom: 1px solid rgba(68, 77, 96, 0.5);
      }

      .topbar-inner,
      main {
        max-width: 1260px;
        margin: 0 auto;
        padding-left: 24px;
        padding-right: 24px;
      }

      .topbar-inner {
        min-height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .repo-mark {
        display: flex;
        align-items: center;
        gap: 14px;
        font-weight: 700;
      }

      .repo-logo {
        width: 38px;
        height: 38px;
        flex: none;
      }

      .repo-mark-copy {
        display: grid;
        gap: 2px;
      }

      .repo-mark-title {
        color: #f8fafc;
        font-size: 0.98rem;
      }

      .repo-mark code {
        color: #ffb088;
        font-size: 0.82rem;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border-radius: 999px;
        border: 1px solid var(--orange-soft-strong);
        background: var(--orange-soft);
        color: #ffd7bf;
        font-size: 0.82rem;
      }

      main {
        padding-top: 34px;
        padding-bottom: 88px;
        display: grid;
        gap: 24px;
      }

      .hero {
        display: grid;
        gap: 24px;
      }

      .panel {
        background:
          linear-gradient(180deg, rgba(21, 24, 33, 0.96), rgba(9, 11, 16, 0.98));
        border: 1px solid var(--border);
        border-radius: 28px;
        box-shadow: var(--shadow);
      }

      .hero-copy {
        padding: 36px;
      }

      .hero-brand {
        display: grid;
        gap: 22px;
      }

      .hero-mark {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
      }

      .hero-logo {
        width: 104px;
        height: 104px;
        flex: none;
        filter: drop-shadow(0 14px 26px rgba(252, 109, 38, 0.2));
      }

      .hero-copy h1,
      .section-head h2 {
        color: #f8fafc;
      }

      .hero-copy h1 {
        margin: 0 0 14px;
        font-size: clamp(3rem, 5vw, 5rem);
        line-height: 0.9;
        letter-spacing: -0.04em;
      }

      .hero-copy p {
        margin: 0;
        max-width: 76ch;
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.8;
      }

      .hero-grid {
        margin-top: 28px;
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      .hero-card,
      .meta-card {
        border: 1px solid var(--border);
        border-radius: 18px;
        background: linear-gradient(180deg, rgba(252, 109, 38, 0.07), rgba(255, 255, 255, 0.02));
      }

      .hero-card {
        padding: 18px;
      }

      .hero-card strong {
        color: #fff3eb;
      }

      .hero-card strong,
      .meta-card strong {
        display: block;
        margin-bottom: 8px;
        color: #f0f6fc;
        font-size: 0.92rem;
      }

      .hero-card span,
      .meta-card span {
        color: var(--muted);
        line-height: 1.6;
        font-size: 0.94rem;
      }

      .workspace {
        padding: 32px;
        display: grid;
        gap: 22px;
      }

      .workspace-head {
        display: grid;
        gap: 12px;
      }

      .workspace-head h2 {
        margin: 0 0 8px;
        font-size: 1.45rem;
      }

      .workspace-head p {
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
      }

      .section-panel {
        padding: 30px 32px;
        display: grid;
        gap: 22px;
      }

      .section-head {
        display: grid;
        gap: 8px;
      }

      .section-kicker {
        color: var(--muted);
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .section-head h2 {
        margin: 0;
        font-size: 1.7rem;
      }

      .section-head p {
        margin: 0;
        max-width: 78ch;
        color: var(--muted);
        line-height: 1.75;
      }

      form {
        display: grid;
        gap: 18px;
      }

      .field-block {
        display: grid;
        gap: 8px;
      }

      label {
        display: grid;
        gap: 8px;
        color: #f0f6fc;
        font-weight: 600;
      }

      input[type="text"],
      input[type="file"],
      textarea,
      select {
        width: 100%;
        border: 1px solid var(--border-strong);
        border-radius: 14px;
        padding: 13px 14px;
        background: #0a0d14;
        color: var(--ink);
        font: inherit;
      }

      input[type="text"]:focus,
      input[type="file"]:focus,
      textarea:focus,
      select:focus {
        outline: none;
        border-color: var(--orange);
        box-shadow: 0 0 0 3px rgba(252, 109, 38, 0.16);
      }

      textarea {
        min-height: 280px;
        resize: vertical;
        line-height: 1.55;
      }

      .field-note {
        color: var(--muted);
        font-weight: 400;
        font-size: 0.88rem;
        line-height: 1.5;
      }

      .generated-path-list {
        display: grid;
        gap: 10px;
        padding: 12px;
        border: 1px solid rgba(48, 54, 61, 0.9);
        border-radius: 12px;
        background: rgba(1, 4, 9, 0.35);
      }

      .paste-support-list {
        display: grid;
        gap: 12px;
      }

      .paste-support-card {
        display: grid;
        gap: 10px;
        padding: 14px;
        border: 1px solid rgba(48, 54, 61, 0.9);
        border-radius: 14px;
        background: rgba(1, 4, 9, 0.35);
      }

      .paste-support-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
      }

      .paste-support-head strong {
        color: #f0f6fc;
      }

      .generated-path-item {
        display: grid;
        gap: 6px;
      }

      .generated-path-source {
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 500;
        word-break: break-all;
      }

      input::file-selector-button {
        margin-right: 12px;
        border: 1px solid var(--border-strong);
        border-radius: 10px;
        padding: 8px 12px;
        background: #1d232e;
        color: var(--ink);
        cursor: pointer;
      }

      .cta-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }

      button {
        border: 1px solid rgba(252, 109, 38, 0.45);
        border-radius: 12px;
        padding: 12px 18px;
        background: linear-gradient(180deg, var(--orange), var(--orange-strong));
        color: white;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }

      .mini-button {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 8px 12px;
        background: rgba(110, 118, 129, 0.08);
        color: var(--ink);
        font: inherit;
        cursor: pointer;
      }

      .ghost {
        border-color: var(--border-strong);
        background: #1d232e;
        color: var(--ink);
      }

      .card-grid {
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .meta-card {
        padding: 18px;
      }

      .meta-card code {
        display: block;
        margin-top: 10px;
        color: #ffb088;
        word-break: break-all;
      }

      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.92em;
      }

      @media (max-width: 1080px) {
        .hero-grid,
        .card-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 760px) {
        .hero-grid,
        .card-grid {
          grid-template-columns: 1fr;
        }

        .hero-copy,
        .workspace,
        .section-panel {
          padding: 24px;
        }

        .hero-mark {
          align-items: flex-start;
        }

        .hero-logo {
          width: 82px;
          height: 82px;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <div class="repo-mark">
          <svg class="repo-logo" viewBox="0 0 128 128" aria-label="GitLab logo" role="img">
            <polygon fill="#e24329" points="64,110 88,36 40,36"/>
            <polygon fill="#fc6d26" points="64,110 24,36 40,36"/>
            <polygon fill="#fc6d26" points="64,110 104,36 88,36"/>
            <polygon fill="#fca326" points="24,36 12,68 40,36"/>
            <polygon fill="#fca326" points="104,36 116,68 88,36"/>
            <polygon fill="#e24329" points="12,68 64,110 24,36"/>
            <polygon fill="#e24329" points="116,68 64,110 104,36"/>
            <polygon fill="#fc6d26" points="40,36 64,18 88,36 64,110"/>
          </svg>
          <div class="repo-mark-copy">
            <span class="repo-mark-title">GitLab CI SSDLC Auditor</span>
            <code>gitlab-ci-ssdlc-auditor</code>
          </div>
        </div>
        <div class="pill">GitLab dark + orange UI</div>
      </div>
    </header>

    <main>
      <section class="hero">
        <article class="panel hero-copy">
          <div class="hero-brand">
            <div class="hero-mark">
              <svg class="hero-logo" viewBox="0 0 128 128" aria-label="GitLab logo" role="img">
                <polygon fill="#e24329" points="64,110 88,36 40,36"/>
                <polygon fill="#fc6d26" points="64,110 24,36 40,36"/>
                <polygon fill="#fc6d26" points="64,110 104,36 88,36"/>
                <polygon fill="#fca326" points="24,36 12,68 40,36"/>
                <polygon fill="#fca326" points="104,36 116,68 88,36"/>
                <polygon fill="#e24329" points="12,68 64,110 24,36"/>
                <polygon fill="#e24329" points="116,68 64,110 104,36"/>
                <polygon fill="#fc6d26" points="40,36 64,18 88,36 64,110"/>
              </svg>
              <div>
                <div class="pill" style="width: fit-content; margin-bottom: 18px;">GitLab CI • SSDLC • Policy Engine</div>
                <h1>Audit the full pipeline, not just one file.</h1>
                <p>
                  The application analyzes <code>.gitlab-ci.yml</code>, local <code>include</code> entries, child and downstream
                  pipelines started by <code>trigger</code>, and breaks the result down into concrete SSDLC gaps:
                  unit tests, SAST, artifact or image scanning, SBOM, secret detection, IaC, DAST, automated test deployment, and security policy compliance.
                </p>
              </div>
            </div>

            <div class="hero-grid">
              <div class="hero-card">
                <strong>Whole Pipeline Graph</strong>
                <span>Recursively collected local <code>include</code> files and child pipelines give you a whole-flow assessment instead of a single-file lint.</span>
              </div>
              <div class="hero-card">
                <strong>Actionable Remediation</strong>
                <span>The report shows the gap, the policy impact, and the concrete remediation path to move the pipeline toward the expected standard.</span>
              </div>
              <div class="hero-card">
                <strong>Multi-Project Scope</strong>
                <span>Optional context manifests let you stitch build, deploy, and delivery repositories into one graph when the release path spans multiple projects.</span>
              </div>
              <div class="hero-card">
                <strong>Trend Memory</strong>
                <span>Persist scan results into a history store and open score drift, category changes, and benchmark movement in the report.</span>
              </div>
            </div>
          </div>
        </article>
      </section>

      <section class="panel workspace">
        <div class="workspace-head">
          <div class="section-head">
            <span class="section-kicker">Audit Workspace</span>
            <h2>Open one clear audit session</h2>
            <p>Provide a repository path, paste the root pipeline, add pasted include files, or upload a ZIP bundle. The HTML report and the GUI use the same analysis engine and produce the same flow graph, findings, and benchmark output.</p>
          </div>
        </div>

          <form id="analysis-form" action="/analyze" method="post" enctype="multipart/form-data">
            <label>
              Pipeline file path
              <input type="text" name="pipeline_path" placeholder="/Users/.../.gitlab-ci.yml">
            </label>

            <div class="field-block">
              <label>
                Or paste a root pipeline file
                <textarea name="pipeline_text" placeholder="Paste .gitlab-ci.yml here for immediate lint, graph generation, and SSDLC feedback"></textarea>
                <span class="field-note">Best for quick analysis. You can also add pasted include or template files below when the root YAML uses local includes or hidden templates.</span>
              </label>
              <label>
                Pasted root filename
                <input type="text" name="pipeline_text_filename" placeholder=".gitlab-ci.yml" value=".gitlab-ci.yml">
                <span class="field-note">Optional. Keep <code>.gitlab-ci.yml</code> unless you need a different root filename for relative context.</span>
              </label>
              <div class="field-block">
                <div class="paste-support-head">
                  <strong>Pasted include or template files</strong>
                  <button id="add-paste-support" class="mini-button" type="button">Add pasted support file</button>
                </div>
                <span class="field-note">Use bundle-relative paths such as <code>.gitlab/ci/templates/build.yml</code> and paste the exact YAML content of each included file.</span>
                <div id="paste-support-list" class="paste-support-list"></div>
              </div>
            </div>

            <label>
              Recommended: pipeline ZIP bundle
              <input type="file" name="pipeline_archive" accept=".zip,application/zip">
              <span class="field-note">Best option for multi-file pipelines, especially when local includes live under hidden paths such as <code>.gitlab/</code>. The archive should contain <code>.gitlab-ci.yml</code> or <code>root.gitlabci.yml</code>.</span>
            </label>

            <label>
              Root pipeline file
              <input type="file" name="pipeline_file" accept=".yml,.yaml">
              <span class="field-note">Fallback for simpler cases. Upload the main <code>.gitlab-ci.yml</code> here when you want the GUI to anchor the analysis to a specific root file.</span>
            </label>

            <div class="field-block">
              <label>
                Additional include or template files
                <input id="pipeline-support-files" type="file" name="pipeline_support_files" accept=".yml,.yaml" multiple>
                <span class="field-note">Use this when the root pipeline depends on a limited set of local files. If nested include paths matter, edit the bundle-relative paths below or prefer directory upload.</span>
              </label>
              <div id="pipeline-support-paths" class="generated-path-list" hidden></div>
            </div>

            <label>
              Or upload a pipeline directory
              <input id="pipeline-directory-files" type="file" name="pipeline_directory_files" accept=".yml,.yaml" webkitdirectory directory multiple>
              <span class="field-note">Fallback for direct folder uploads. Some browsers can still be inconsistent with hidden folders, so ZIP remains the safer option for complex repositories.</span>
            </label>

            <label>
              Root pipeline path inside uploaded bundle
              <input type="text" name="pipeline_bundle_root" placeholder=".gitlab-ci.yml or .gitlab/ci/root.yml">
              <span class="field-note">Optional. Use this when you upload a whole folder and the root pipeline is not the top-level `.gitlab-ci.yml`, or when multiple root candidates exist.</span>
            </label>

            <label>
              Downstream snapshot manifest
              <input type="text" name="snapshot_file_path" placeholder="/Users/.../.gitlab-ci-downstream-snapshots.json" value="<%= ERB::Util.html_escape(default_snapshot_file) %>">
              <span class="field-note">Optional JSON manifest that maps external or artifact-based child pipelines to imported local YAML snapshots.</span>
            </label>

            <label>
              Multi-project context manifest
              <input type="text" name="context_file_path" placeholder="/Users/.../pipeline-context.json" value="<%= ERB::Util.html_escape(default_context_file) %>">
              <span class="field-note">Optional JSON manifest that links multiple repositories into one pipeline graph, for example application build -> ArgoCD delivery repo.</span>
            </label>

            <label>
              History store file
              <input type="text" name="history_file_path" placeholder="/Users/.../gitlab-ci-audit-history.json" value="<%= ERB::Util.html_escape(default_history_file) %>">
              <span class="field-note">Optional JSON file used to append this scan result and render the trend dashboard in the report.</span>
            </label>

            <label>
              Policy pack
              <select name="policy_pack" <%= custom_policy_locked ? "disabled" : "" %>>
                <% available_policy_packs.each do |pack| %>
                  <option value="<%= pack[:name] %>" <%= pack[:name] == selected_policy_pack ? "selected" : "" %>><%= pack[:label] %> (<%= pack[:name] %>)</option>
                <% end %>
              </select>
              <% if custom_policy_locked %>
                <span class="field-note">This server instance was started with an explicit custom policy file, so bundled policy pack selection is locked.</span>
              <% else %>
                <% selected_pack = available_policy_packs.find { |pack| pack[:name] == selected_policy_pack } %>
                <span class="field-note"><%= selected_pack ? selected_pack[:description] : "Choose a bundled policy pack for this audit run." %></span>
              <% end %>
            </label>

            <div class="cta-row">
              <button type="submit">Analyze Pipeline</button>
              <button type="button" class="ghost" onclick="window.location.reload()">Reset Form</button>
            </div>
          </form>
      </section>

      <section class="panel section-panel">
        <div class="section-head">
          <span class="section-kicker">What You Get</span>
          <h2>Readable output across security, quality, and delivery</h2>
          <p>The UI is split into large, readable sections so the first screen is for running the audit, and the next sections explain what the platform evaluates and how to use it in practice.</p>
        </div>

        <div class="card-grid">
          <article class="meta-card">
            <strong>Lint and structure</strong>
            <span>Static parser validation, include diagnostics, missing templates, alias issues, and pipeline structure warnings before you even review SSDLC coverage.</span>
          </article>
          <article class="meta-card">
            <strong>SSDLC controls</strong>
            <span>Unit tests, coverage, SAST, artifact or image scanning, SBOM, secret detection, IaC, DAST, and automated deployment to a test environment.</span>
          </article>
          <article class="meta-card">
            <strong>OWASP SAMM v2</strong>
            <span>Benchmark estimates for the `Implementation` function with question-level mapping, observed detection signals, and rule-by-rule recommendations.</span>
          </article>
          <article class="meta-card">
            <strong>Flow graph</strong>
            <span>Pipeline graph, trigger chains, stage ordering, and weak or strong points visible in one report instead of spread across templates.</span>
          </article>
          <article class="meta-card">
            <strong>Policy packs</strong>
            <span>Balanced, strict, and library-oriented baselines make it easier to keep one engine while changing organizational expectations.</span>
          </article>
          <article class="meta-card">
            <strong>History and trends</strong>
            <span>Optional history storage lets teams compare runs over time and understand whether a pipeline is improving or drifting.</span>
          </article>
        </div>
      </section>

      <section class="panel section-panel">
        <div class="section-head">
          <span class="section-kicker">Run Modes</span>
          <h2>CLI, GUI, exports, and container packaging</h2>
          <p>Use the same engine locally, in Docker, or as a web UI. The goal is one analysis model with several entry points.</p>
        </div>

        <div class="card-grid">
          <article class="meta-card">
          <strong>CLI</strong>
          <span>Command-line entrypoint that generates text, JSON, or HTML output.</span>
          <code>./bin/gitlab-ci-auditor scan .gitlab-ci.yml</code>
        </article>
        <article class="meta-card">
          <strong>HTML Report</strong>
          <span>Report with scoring categories, SSDLC gaps, security findings, and remediation guidance.</span>
          <code>./bin/gitlab-ci-auditor scan .gitlab-ci.yml --format html --output report.html</code>
        </article>
        <article class="meta-card">
          <strong>Exports</strong>
          <span>Alternative export formats for integrations and audit handoff.</span>
          <code>./bin/gitlab-ci-auditor scan .gitlab-ci.yml --format csv|pdf|json-bundle</code>
        </article>
        <article class="meta-card">
          <strong>GUI</strong>
          <span>Web UI for fast audits and easier presentation of results to engineering teams.</span>
          <code>./bin/gitlab-ci-auditor serve --host 127.0.0.1 --port 4567</code>
        </article>
        <article class="meta-card">
          <strong>Rule Packs</strong>
          <span>Bundled policy packs let you switch between balanced, strict, and library-oriented SSDLC baselines.</span>
          <code>./bin/gitlab-ci-auditor list-packs</code>
        </article>
        <article class="meta-card">
          <strong>Docker</strong>
          <span>Run scans or serve the GUI from a container with the target repository mounted into `/workspace`.</span>
          <code>docker build -t gitlab-ci-ssdlc-auditor .</code>
        </article>
        <article class="meta-card">
          <strong>Examples</strong>
          <span>Generate repository-backed sample reports for compliant, library, legacy, and downstream snapshot cases.</span>
          <code>./scripts/generate_example_reports.sh</code>
        </article>
        </div>
      </section>

      <section class="panel section-panel">
        <div class="section-head">
          <span class="section-kicker">Example Pipelines</span>
          <h2>Reference cases for quick verification</h2>
          <p>Use these samples to verify how the analyzer responds to strong, weak, downstream, and multi-repository delivery setups.</p>
        </div>

        <div class="card-grid">
          <article class="meta-card">
          <strong>Compliant Service</strong>
          <span>Balanced baseline with unit tests, coverage, SAST, artifact scanning, and automated test deployment.</span>
          <code>examples/pipelines/compliant_service.gitlab-ci.yml</code>
        </article>
        <article class="meta-card">
          <strong>Library Package</strong>
          <span>Library-pack example with tests, coverage, SAST, and scanning, but no test deployment step.</span>
          <code>examples/pipelines/library_package.gitlab-ci.yml</code>
        </article>
        <article class="meta-card">
          <strong>Legacy Monolith</strong>
          <span>Intentional anti-pattern sample with skipped tests, latest image usage, and manual test deployment.</span>
          <code>examples/pipelines/legacy_monolith.gitlab-ci.yml</code>
        </article>
        <article class="meta-card">
          <strong>Snapshot Downstream</strong>
          <span>External child pipeline resolved through a local snapshot manifest.</span>
          <code>examples/pipelines/snapshot_root.gitlab-ci.yml</code>
        </article>
        <article class="meta-card">
          <strong>ArgoCD Delivery</strong>
          <span>SonarQube plus script-backed Trivy scanning, with test deployment proven from an external ArgoCD repository snapshot.</span>
          <code>examples/pipelines/argocd_release_root.gitlab-ci.yml</code>
        </article>
        </div>
      </section>
    </main>
    <script>
      document.addEventListener("DOMContentLoaded", function() {
        var form = document.getElementById("analysis-form");
        var directoryInput = document.getElementById("pipeline-directory-files");
        var supportInput = document.getElementById("pipeline-support-files");
        var supportPaths = document.getElementById("pipeline-support-paths");
        var pasteSupportList = document.getElementById("paste-support-list");
        var addPasteSupportButton = document.getElementById("add-paste-support");

        if (!form || !directoryInput || !supportInput || !supportPaths || !pasteSupportList || !addPasteSupportButton) {
          return;
        }

        function renderSupportPathEditors() {
          supportPaths.innerHTML = "";

          var files = Array.prototype.slice.call(supportInput.files || []);
          supportPaths.hidden = files.length === 0;
          if (files.length === 0) {
            return;
          }

          var intro = document.createElement("span");
          intro.className = "field-note";
          intro.textContent = "Bundle-relative paths for the selected support files. Edit these when the original repository layout uses nested directories such as .gitlab/ci/templates/job.yml.";
          supportPaths.appendChild(intro);

          files.forEach(function(file) {
            var item = document.createElement("div");
            item.className = "generated-path-item";

            var source = document.createElement("span");
            source.className = "generated-path-source";
            source.textContent = "Selected file: " + file.name;
            item.appendChild(source);

            var input = document.createElement("input");
            input.type = "text";
            input.name = "pipeline_support_paths";
            input.value = file.webkitRelativePath || file.name;
            input.placeholder = ".gitlab/ci/templates/job.yml";
            item.appendChild(input);

            supportPaths.appendChild(item);
          });
        }

        supportInput.addEventListener("change", renderSupportPathEditors);
        renderSupportPathEditors();

        function escapeHtml(value) {
          return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
        }

        function escapeAttribute(value) {
          return escapeHtml(value).replace(/"/g, "&quot;");
        }

        function refreshPasteSupportLabels() {
          Array.prototype.slice.call(pasteSupportList.querySelectorAll(".paste-support-card")).forEach(function(card, index) {
            var label = card.querySelector(".paste-support-head strong");
            if (label) {
              label.textContent = "Support file " + (index + 1);
            }
          });
        }

        function buildPasteSupportCard(index, pathValue, contentValue) {
          var card = document.createElement("div");
          card.className = "paste-support-card";
          card.innerHTML =
            '<div class="paste-support-head">' +
              "<strong>Support file " + (index + 1) + "</strong>" +
              '<button type="button" class="mini-button" data-remove-paste-support="true">Remove</button>' +
            "</div>" +
            '<label>Bundle-relative path' +
              '<input type="text" name="pipeline_text_support_paths" placeholder=".gitlab/ci/templates/prepare.yml" value="' + escapeAttribute(pathValue || "") + '">' +
            "</label>" +
            '<label>YAML content' +
              '<textarea name="pipeline_text_support_contents" placeholder="Paste included YAML here">' + escapeHtml(contentValue || "") + "</textarea>" +
            "</label>";

          card.querySelector('[data-remove-paste-support="true"]').addEventListener("click", function() {
            card.remove();
            refreshPasteSupportLabels();
          });

          return card;
        }

        addPasteSupportButton.addEventListener("click", function() {
          pasteSupportList.appendChild(buildPasteSupportCard(
            pasteSupportList.querySelectorAll(".paste-support-card").length,
            "",
            ""
          ));
          refreshPasteSupportLabels();
        });

        if (!pasteSupportList.querySelector(".paste-support-card")) {
          pasteSupportList.appendChild(buildPasteSupportCard(0, "", ""));
          refreshPasteSupportLabels();
        }

        form.addEventListener("submit", function() {
          form.querySelectorAll("input[data-generated-path='true']").forEach(function(node) {
            node.remove();
          });

          Array.prototype.forEach.call(directoryInput.files || [], function(file) {
            var hidden = document.createElement("input");
            hidden.type = "hidden";
            hidden.name = "pipeline_directory_paths";
            hidden.value = file.webkitRelativePath || file.name;
            hidden.setAttribute("data-generated-path", "true");
            form.appendChild(hidden);
          });
        });
      });
    </script>
  </body>
</html>
