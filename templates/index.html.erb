<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>GitLab CI SSDLC Auditor</title>
    <style>
      :root {
        --bg: #0e1016;
        --bg-accent: #05070d;
        --panel: #151821;
        --panel-soft: #10131b;
        --border: #2f3442;
        --border-strong: #444d60;
        --ink: #dce3ea;
        --muted: #99a4b3;
        --orange: #fc6d26;
        --orange-strong: #e24329;
        --orange-soft: rgba(252, 109, 38, 0.16);
        --orange-soft-strong: rgba(252, 109, 38, 0.28);
        --amber: #fca326;
        --red: #f85149;
        --yellow: #d7a33e;
        --shadow: 0 28px 80px rgba(0, 0, 0, 0.45);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(252, 109, 38, 0.18), transparent 24%),
          radial-gradient(circle at top right, rgba(226, 67, 41, 0.16), transparent 28%),
          linear-gradient(180deg, rgba(21, 24, 33, 0.94), rgba(14, 16, 22, 1)),
          var(--bg);
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(18px);
        background: rgba(14, 16, 22, 0.88);
        border-bottom: 1px solid rgba(68, 77, 96, 0.5);
      }

      .topbar-inner,
      main {
        max-width: 1260px;
        margin: 0 auto;
        padding-left: 24px;
        padding-right: 24px;
      }

      .topbar-inner {
        min-height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .repo-mark {
        display: flex;
        align-items: center;
        gap: 14px;
        font-weight: 700;
      }

      .repo-logo {
        width: 38px;
        height: 38px;
        flex: none;
      }

      .repo-mark-copy {
        display: grid;
        gap: 2px;
      }

      .repo-mark-title {
        color: #f8fafc;
        font-size: 0.98rem;
      }

      .repo-mark code {
        color: #ffb088;
        font-size: 0.82rem;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border-radius: 999px;
        border: 1px solid var(--orange-soft-strong);
        background: var(--orange-soft);
        color: #ffd7bf;
        font-size: 0.82rem;
      }

      main {
        padding-top: 34px;
        padding-bottom: 88px;
        display: grid;
        gap: 24px;
      }

      .hero {
        display: grid;
        gap: 24px;
      }

      .panel {
        background:
          linear-gradient(180deg, rgba(21, 24, 33, 0.96), rgba(9, 11, 16, 0.98));
        border: 1px solid var(--border);
        border-radius: 28px;
        box-shadow: var(--shadow);
      }

      .hero-copy {
        padding: 36px;
      }

      .hero-brand {
        display: grid;
        gap: 22px;
      }

      .hero-mark {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
      }

      .hero-logo {
        width: 104px;
        height: 104px;
        flex: none;
        filter: drop-shadow(0 14px 26px rgba(252, 109, 38, 0.2));
      }

      .hero-copy h1,
      .section-head h2 {
        color: #f8fafc;
      }

      .hero-copy h1 {
        margin: 0 0 14px;
        font-size: clamp(3rem, 5vw, 5rem);
        line-height: 0.9;
        letter-spacing: -0.04em;
      }

      .hero-copy p {
        margin: 0;
        max-width: 76ch;
        color: var(--muted);
        font-size: 1.05rem;
        line-height: 1.8;
      }

      .hero-grid {
        margin-top: 28px;
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      .hero-card,
      .meta-card {
        border: 1px solid var(--border);
        border-radius: 18px;
        background: linear-gradient(180deg, rgba(252, 109, 38, 0.07), rgba(255, 255, 255, 0.02));
      }

      .hero-card {
        padding: 18px;
      }

      .hero-card strong {
        color: #fff3eb;
      }

      .hero-card strong,
      .meta-card strong {
        display: block;
        margin-bottom: 8px;
        color: #f0f6fc;
        font-size: 0.92rem;
      }

      .hero-card span,
      .meta-card span {
        color: var(--muted);
        line-height: 1.6;
        font-size: 0.94rem;
      }

      .workspace {
        padding: 32px;
        display: grid;
        gap: 22px;
      }

      .workspace-head {
        display: grid;
        gap: 12px;
      }

      .workspace-head h2 {
        margin: 0 0 8px;
        font-size: 1.45rem;
      }

      .workspace-head p {
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
      }

      .section-panel {
        padding: 30px 32px;
        display: grid;
        gap: 22px;
      }

      .section-head {
        display: grid;
        gap: 8px;
      }

      .section-kicker {
        color: var(--muted);
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .section-head h2 {
        margin: 0;
        font-size: 1.7rem;
      }

      .section-head p {
        margin: 0;
        max-width: 78ch;
        color: var(--muted);
        line-height: 1.75;
      }

      form {
        display: grid;
        gap: 18px;
      }

      .field-block {
        display: grid;
        gap: 8px;
      }

      label {
        display: grid;
        gap: 8px;
        color: #f0f6fc;
        font-weight: 600;
      }

      input[type="text"],
      input[type="file"],
      textarea,
      select {
        width: 100%;
        border: 1px solid var(--border-strong);
        border-radius: 14px;
        padding: 13px 14px;
        background: #0a0d14;
        color: var(--ink);
        font: inherit;
      }

      input[type="text"]:focus,
      input[type="file"]:focus,
      textarea:focus,
      select:focus {
        outline: none;
        border-color: var(--orange);
        box-shadow: 0 0 0 3px rgba(252, 109, 38, 0.16);
      }

      textarea {
        min-height: 280px;
        resize: vertical;
        line-height: 1.55;
      }

      .field-note {
        color: var(--muted);
        font-weight: 400;
        font-size: 0.88rem;
        line-height: 1.5;
      }

      input::file-selector-button {
        margin-right: 12px;
        border: 1px solid var(--border-strong);
        border-radius: 10px;
        padding: 8px 12px;
        background: #1d232e;
        color: var(--ink);
        cursor: pointer;
      }

      .cta-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }

      .workspace-tabbar {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      .workspace-tab {
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 10px 14px;
        background: rgba(252, 109, 38, 0.06);
        color: var(--muted);
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }

      .workspace-tab.active {
        color: #fff3eb;
        background: rgba(252, 109, 38, 0.16);
        border-color: rgba(252, 109, 38, 0.42);
      }

      .workspace-panel[hidden] {
        display: none;
      }

      .settings-layout {
        display: grid;
        gap: 18px;
        grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
      }

      .settings-card {
        padding: 18px;
        border-radius: 18px;
        border: 1px solid var(--border);
        background: linear-gradient(180deg, rgba(252, 109, 38, 0.07), rgba(255, 255, 255, 0.02));
      }

      .settings-card h3 {
        margin: 0 0 10px;
        color: #f8fafc;
        font-size: 1rem;
      }

      .settings-status {
        padding: 12px 14px;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: rgba(1, 4, 9, 0.35);
        color: var(--muted);
        line-height: 1.6;
      }

      .settings-status.success {
        color: #8ef0a5;
        border-color: rgba(63, 185, 80, 0.28);
        background: rgba(46, 160, 67, 0.08);
      }

      .settings-status.error {
        color: #ffaea9;
        border-color: rgba(248, 81, 73, 0.28);
        background: rgba(248, 81, 73, 0.08);
      }

      .divider-copy {
        padding: 14px 16px;
        border-radius: 16px;
        border: 1px dashed var(--border);
        background: rgba(1, 4, 9, 0.18);
        color: var(--muted);
        line-height: 1.65;
      }

      button {
        border: 1px solid rgba(252, 109, 38, 0.45);
        border-radius: 12px;
        padding: 12px 18px;
        background: linear-gradient(180deg, var(--orange), var(--orange-strong));
        color: white;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }

      .ghost {
        border-color: var(--border-strong);
        background: #1d232e;
        color: var(--ink);
      }

      .card-grid {
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .meta-card {
        padding: 18px;
      }

      .meta-card code {
        display: block;
        margin-top: 10px;
        color: #ffb088;
        word-break: break-all;
      }

      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.92em;
      }

      @media (max-width: 1080px) {
        .hero-grid,
        .card-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 760px) {
        .hero-grid,
        .card-grid {
          grid-template-columns: 1fr;
        }

        .hero-copy,
        .workspace,
        .section-panel {
          padding: 24px;
        }

        .hero-mark {
          align-items: flex-start;
        }

        .hero-logo {
          width: 82px;
          height: 82px;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <div class="repo-mark">
          <svg class="repo-logo" viewBox="0 0 128 128" aria-label="GitLab logo" role="img">
            <polygon fill="#e24329" points="64,110 88,36 40,36"/>
            <polygon fill="#fc6d26" points="64,110 24,36 40,36"/>
            <polygon fill="#fc6d26" points="64,110 104,36 88,36"/>
            <polygon fill="#fca326" points="24,36 12,68 40,36"/>
            <polygon fill="#fca326" points="104,36 116,68 88,36"/>
            <polygon fill="#e24329" points="12,68 64,110 24,36"/>
            <polygon fill="#e24329" points="116,68 64,110 104,36"/>
            <polygon fill="#fc6d26" points="40,36 64,18 88,36 64,110"/>
          </svg>
          <div class="repo-mark-copy">
            <span class="repo-mark-title">GitLab CI SSDLC Auditor</span>
            <code>gitlab-ci-ssdlc-auditor</code>
          </div>
        </div>
        <div class="pill">GitLab dark + orange UI</div>
      </div>
    </header>

    <main>
      <section class="hero">
        <article class="panel hero-copy">
          <div class="hero-brand">
            <div class="hero-mark">
              <svg class="hero-logo" viewBox="0 0 128 128" aria-label="GitLab logo" role="img">
                <polygon fill="#e24329" points="64,110 88,36 40,36"/>
                <polygon fill="#fc6d26" points="64,110 24,36 40,36"/>
                <polygon fill="#fc6d26" points="64,110 104,36 88,36"/>
                <polygon fill="#fca326" points="24,36 12,68 40,36"/>
                <polygon fill="#fca326" points="104,36 116,68 88,36"/>
                <polygon fill="#e24329" points="12,68 64,110 24,36"/>
                <polygon fill="#e24329" points="116,68 64,110 104,36"/>
                <polygon fill="#fc6d26" points="40,36 64,18 88,36 64,110"/>
              </svg>
              <div>
                <div class="pill" style="width: fit-content; margin-bottom: 18px;">GitLab CI • SSDLC • Policy Engine</div>
                <h1>Audit the full pipeline, not just one file.</h1>
                <p>
                  The application analyzes <code>.gitlab-ci.yml</code>, local <code>include</code> entries, child and downstream
                  pipelines started by <code>trigger</code>, and breaks the result down into concrete SSDLC gaps:
                  unit tests, SAST, artifact or image scanning, SBOM, secret detection, IaC, DAST, automated test deployment, and security policy compliance.
                </p>
              </div>
            </div>

            <div class="hero-grid">
              <div class="hero-card">
                <strong>Whole Pipeline Graph</strong>
                <span>Recursively collected local <code>include</code> files and child pipelines give you a whole-flow assessment instead of a single-file lint.</span>
              </div>
              <div class="hero-card">
                <strong>Actionable Remediation</strong>
                <span>The report shows the gap, the policy impact, and the concrete remediation path to move the pipeline toward the expected standard.</span>
              </div>
              <div class="hero-card">
                <strong>Policy Settings</strong>
                <span>Preview bundled policies, clone them, tune the JSON, and save custom GUI policies directly in the browser.</span>
              </div>
              <div class="hero-card">
                <strong>Export Ready</strong>
                <span>After analysis, export the rendered report directly to HTML, text, CSV, PDF, JSON bundle, SARIF, or JUnit.</span>
              </div>
            </div>
          </div>
        </article>
      </section>

      <section class="panel workspace">
        <div class="workspace-head">
          <div class="section-head">
            <span class="section-kicker">Audit Workspace</span>
            <h2>Flatten first, then analyze in one place</h2>
            <p>The GUI now focuses on one predictable input model: flattened pipeline YAML from <code>./scripts/flatten_pipeline.sh</code>. Advanced multi-file, snapshot, and multi-project ingestion stays in CLI, where it is easier to control and debug.</p>
          </div>
        </div>

        <div class="workspace-tabbar" role="tablist" aria-label="Workspace views">
          <button class="workspace-tab active" type="button" data-workspace-tab="analyze">Analyze</button>
          <button class="workspace-tab" type="button" data-workspace-tab="settings">Settings</button>
        </div>

        <div class="workspace-panel" data-workspace-panel="analyze">
          <form id="analysis-form" action="/analyze" method="post" enctype="multipart/form-data">
            <input type="hidden" name="pipeline_text_filename" value="flat.gitlab-ci.yml">
            <input type="hidden" name="policy_json" id="analysis-policy-json">

            <div class="divider-copy">
              Generate the flat file in your repository first:
              <code>./scripts/flatten_pipeline.sh .gitlab-ci.yml --output flat.gitlab-ci.yml</code>.
              Then paste that YAML here or upload the generated file. This keeps the GUI fast and deterministic even for large include trees.
            </div>

            <label>
              Paste flattened pipeline YAML
              <textarea name="pipeline_text" placeholder="Paste flat.gitlab-ci.yml here"></textarea>
              <span class="field-note">Paste YAML only. The GUI expects the already-flattened pipeline content, not the shell helper that generated it.</span>
            </label>

            <label>
              Or upload flattened pipeline YAML
              <input type="file" name="pipeline_file" accept=".yml,.yaml">
              <span class="field-note">Upload the generated <code>flat.gitlab-ci.yml</code> or another single flattened YAML artifact.</span>
            </label>

            <label>
              Policy for this analysis
              <select name="policy_ref" id="analysis-policy-ref" <%= custom_policy_locked ? "disabled" : "" %>></select>
              <% if custom_policy_locked %>
                <span class="field-note">This server was started with an explicit policy file, so GUI policy selection is locked for analysis.</span>
              <% else %>
                <span class="field-note" id="analysis-policy-note">Choose a bundled or custom GUI policy.</span>
              <% end %>
            </label>

            <div class="divider-copy">
              Need downstream snapshots, multi-project context, or historical tracking? Use CLI for those advanced workflows, then bring the flattened YAML back into the GUI when you want the visual report.
            </div>

            <div class="cta-row">
              <button type="submit">Analyze Pipeline</button>
              <button type="button" class="ghost" id="reset-analysis-form">Reset Form</button>
            </div>
          </form>
        </div>

        <div class="workspace-panel" data-workspace-panel="settings" hidden>
          <div class="settings-layout">
            <div class="settings-card">
              <h3>Policy Editor</h3>
              <div class="field-block">
                <label>
                  Policy catalog
                  <select id="settings-policy-ref"></select>
                  <span class="field-note">Bundled policies are read-only baselines. Clone one into a custom policy before changing it.</span>
                </label>
                <label>
                  Custom policy name
                  <input type="text" id="settings-policy-name" value="<%= ERB::Util.html_escape(default_policy_entry ? "#{default_policy_entry[:name]}_custom" : "custom_policy") %>">
                  <span class="field-note">Used as the stable frontend identifier for the saved policy.</span>
                </label>
                <label>
                  Custom policy label
                  <input type="text" id="settings-policy-label" value="<%= ERB::Util.html_escape(default_policy_entry ? default_policy_entry[:label] : "Custom Policy") %>">
                  <span class="field-note">Human-readable label shown in the analysis selector and reports.</span>
                </label>
                <label>
                  Policy JSON
                  <textarea id="settings-policy-json" spellcheck="false"><%= ERB::Util.html_escape(default_policy_json) %></textarea>
                  <span class="field-note">Full policy document with live validation before save. Saved GUI policies are kept in browser storage and become immediately selectable for analysis.</span>
                </label>
              </div>

              <div class="cta-row">
                <button type="button" id="policy-new-button" class="ghost">New Draft</button>
                <button type="button" id="policy-clone-button" class="ghost">Clone Selected</button>
                <button type="button" id="policy-save-button">Save Custom Policy</button>
                <button type="button" id="policy-delete-button" class="ghost">Delete Custom Policy</button>
              </div>

              <div id="policy-status" class="settings-status" hidden></div>
            </div>

            <div class="settings-card">
              <h3>How policy settings work</h3>
              <div class="list" style="margin-top: 0;">
                <div class="list-item">
                  Pick a bundled baseline such as <code>balanced</code>, <code>strict</code>, or <code>library</code>.
                </div>
                <div class="list-item">
                  Clone it, edit the JSON, and save it as a custom GUI policy.
                </div>
                <div class="list-item">
                  The saved custom policy appears immediately in the analysis selector on the <strong>Analyze</strong> tab.
                </div>
                <div class="list-item">
                  CLI remains the right place for repository-wide policy files that should be versioned in Git.
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="panel section-panel">
        <div class="section-head">
          <span class="section-kicker">What You Get</span>
          <h2>Readable output across security, quality, and delivery</h2>
          <p>The UI is split into large, readable sections so the first screen is for running the audit, and the next sections explain what the platform evaluates and how to use it in practice.</p>
        </div>

        <div class="card-grid">
          <article class="meta-card">
            <strong>Lint and structure</strong>
            <span>Static parser validation, include diagnostics, missing templates, alias issues, and pipeline structure warnings before you even review SSDLC coverage.</span>
          </article>
          <article class="meta-card">
            <strong>SSDLC controls</strong>
            <span>Unit tests, coverage, SAST, artifact or image scanning, SBOM, secret detection, IaC, DAST, and automated deployment to a test environment.</span>
          </article>
          <article class="meta-card">
            <strong>OWASP SAMM v2</strong>
            <span>Benchmark estimates for the `Implementation` function with question-level mapping, observed detection signals, and rule-by-rule recommendations.</span>
          </article>
          <article class="meta-card">
            <strong>Flow graph</strong>
            <span>Pipeline graph, trigger chains, stage ordering, and weak or strong points visible in one report instead of spread across templates.</span>
          </article>
          <article class="meta-card">
            <strong>Policy packs</strong>
            <span>Balanced, strict, and library-oriented baselines make it easier to keep one engine while changing organizational expectations.</span>
          </article>
          <article class="meta-card">
            <strong>History and trends</strong>
            <span>Optional history storage lets teams compare runs over time and understand whether a pipeline is improving or drifting.</span>
          </article>
        </div>
      </section>

      <section class="panel section-panel">
        <div class="section-head">
          <span class="section-kicker">Run Modes</span>
          <h2>CLI, GUI, exports, and container packaging</h2>
          <p>Use the same engine locally, in Docker, or as a web UI. The goal is one analysis model with several entry points.</p>
        </div>

        <div class="card-grid">
          <article class="meta-card">
          <strong>CLI</strong>
          <span>Command-line entrypoint that generates text, JSON, or HTML output.</span>
          <code>./bin/gitlab-ci-auditor scan .gitlab-ci.yml</code>
        </article>
        <article class="meta-card">
          <strong>HTML Report</strong>
          <span>Report with scoring categories, SSDLC gaps, security findings, and remediation guidance.</span>
          <code>./bin/gitlab-ci-auditor scan .gitlab-ci.yml --format html --output report.html</code>
        </article>
        <article class="meta-card">
          <strong>Exports</strong>
          <span>Alternative export formats for integrations and audit handoff.</span>
          <code>./bin/gitlab-ci-auditor scan .gitlab-ci.yml --format csv|pdf|json-bundle</code>
        </article>
        <article class="meta-card">
          <strong>GUI</strong>
          <span>Web UI for fast audits and easier presentation of results to engineering teams.</span>
          <code>./bin/gitlab-ci-auditor serve --host 127.0.0.1 --port 4567</code>
        </article>
        <article class="meta-card">
          <strong>Rule Packs</strong>
          <span>Bundled policy packs let you switch between balanced, strict, and library-oriented SSDLC baselines.</span>
          <code>./bin/gitlab-ci-auditor list-packs</code>
        </article>
        <article class="meta-card">
          <strong>Docker</strong>
          <span>Run scans or serve the GUI from a container with the target repository mounted into `/workspace`.</span>
          <code>docker build -t gitlab-ci-ssdlc-auditor .</code>
        </article>
        <article class="meta-card">
          <strong>Examples</strong>
          <span>Generate repository-backed sample reports for compliant, library, legacy, and downstream snapshot cases.</span>
          <code>./scripts/generate_example_reports.sh</code>
        </article>
        </div>
      </section>

      <section class="panel section-panel">
        <div class="section-head">
          <span class="section-kicker">Example Pipelines</span>
          <h2>Reference cases for quick verification</h2>
          <p>Use these samples to verify how the analyzer responds to strong, weak, downstream, and multi-repository delivery setups.</p>
        </div>

        <div class="card-grid">
          <article class="meta-card">
          <strong>Compliant Service</strong>
          <span>Balanced baseline with unit tests, coverage, SAST, artifact scanning, and automated test deployment.</span>
          <code>examples/pipelines/compliant_service.gitlab-ci.yml</code>
        </article>
        <article class="meta-card">
          <strong>Library Package</strong>
          <span>Library-pack example with tests, coverage, SAST, and scanning, but no test deployment step.</span>
          <code>examples/pipelines/library_package.gitlab-ci.yml</code>
        </article>
        <article class="meta-card">
          <strong>Legacy Monolith</strong>
          <span>Intentional anti-pattern sample with skipped tests, latest image usage, and manual test deployment.</span>
          <code>examples/pipelines/legacy_monolith.gitlab-ci.yml</code>
        </article>
        <article class="meta-card">
          <strong>Snapshot Downstream</strong>
          <span>External child pipeline resolved through a local snapshot manifest.</span>
          <code>examples/pipelines/snapshot_root.gitlab-ci.yml</code>
        </article>
        <article class="meta-card">
          <strong>ArgoCD Delivery</strong>
          <span>SonarQube plus script-backed Trivy scanning, with test deployment proven from an external ArgoCD repository snapshot.</span>
          <code>examples/pipelines/argocd_release_root.gitlab-ci.yml</code>
        </article>
        </div>
      </section>
    </main>
    <script id="policy-catalog-data" type="application/json"><%= default_policy_catalog_json %></script>
    <script>
      (function () {
        var policyCatalog = JSON.parse(document.getElementById("policy-catalog-data").textContent || "[]");
        var customPolicyStorageKey = "gitlab_ci_auditor.custom_policies.v1";
        var workspaceTabs = Array.prototype.slice.call(document.querySelectorAll(".workspace-tab"));
        var workspacePanels = Array.prototype.slice.call(document.querySelectorAll(".workspace-panel"));
        var analysisForm = document.getElementById("analysis-form");
        var analysisPolicyRef = document.getElementById("analysis-policy-ref");
        var analysisPolicyJson = document.getElementById("analysis-policy-json");
        var analysisPolicyNote = document.getElementById("analysis-policy-note");
        var resetAnalysisButton = document.getElementById("reset-analysis-form");
        var settingsPolicyRef = document.getElementById("settings-policy-ref");
        var settingsPolicyName = document.getElementById("settings-policy-name");
        var settingsPolicyLabel = document.getElementById("settings-policy-label");
        var settingsPolicyJson = document.getElementById("settings-policy-json");
        var policyStatus = document.getElementById("policy-status");
        var policyNewButton = document.getElementById("policy-new-button");
        var policyCloneButton = document.getElementById("policy-clone-button");
        var policySaveButton = document.getElementById("policy-save-button");
        var policyDeleteButton = document.getElementById("policy-delete-button");
        var customPolicyLocked = <%= custom_policy_locked ? "true" : "false" %>;
        var defaultPolicyRef = "<%= ERB::Util.html_escape(default_policy_ref) %>";

        function escapeHtml(value) {
          return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
        }

        function activateWorkspaceTab(name) {
          workspaceTabs.forEach(function (button) {
            button.classList.toggle("active", button.dataset.workspaceTab === name);
          });

          workspacePanels.forEach(function (panel) {
            panel.hidden = panel.dataset.workspacePanel !== name;
          });
        }

        workspaceTabs.forEach(function (button) {
          button.addEventListener("click", function () {
            activateWorkspaceTab(button.dataset.workspaceTab);
          });
        });

        function loadCustomPolicies() {
          try {
            var parsed = JSON.parse(window.localStorage.getItem(customPolicyStorageKey) || "{}");
            return parsed && typeof parsed === "object" ? parsed : {};
          } catch (_error) {
            return {};
          }
        }

        function persistCustomPolicies(policies) {
          window.localStorage.setItem(customPolicyStorageKey, JSON.stringify(policies));
        }

        function combinedPolicies() {
          var customPolicies = loadCustomPolicies();
          var entries = policyCatalog.slice();

          Object.keys(customPolicies).sort().forEach(function (key) {
            entries.push(customPolicies[key]);
          });

          return entries;
        }

        function findPolicyEntry(ref) {
          return combinedPolicies().find(function (entry) { return entry.id === ref; }) || null;
        }

        function populatePolicySelect(selectElement, selectedRef) {
          if (!selectElement) {
            return;
          }

          var entries = combinedPolicies();
          selectElement.innerHTML = entries.map(function (entry) {
            var selected = entry.id === selectedRef ? ' selected' : "";
            var suffix = entry.kind === "custom" ? "custom" : "bundled";
            return '<option value="' + escapeHtml(entry.id) + '"' + selected + ">" +
              escapeHtml(entry.label + " (" + suffix + ")") +
              "</option>";
          }).join("");
        }

        function updateAnalysisPolicyState() {
          if (!analysisPolicyRef) {
            return;
          }

          var entry = findPolicyEntry(analysisPolicyRef.value);
          if (entry && analysisPolicyNote) {
            analysisPolicyNote.textContent = entry.description || (entry.kind === "custom" ? "Custom GUI policy stored in this browser." : "Bundled baseline policy.");
          }
        }

        function applyPolicyToSettings(ref, options) {
          var entry = findPolicyEntry(ref) || findPolicyEntry(defaultPolicyRef);
          if (!entry) {
            return;
          }

          var preserveName = options && options.preserveName;
          settingsPolicyRef.value = entry.id;
          settingsPolicyJson.value = entry.json;

          if (!preserveName) {
            settingsPolicyName.value = entry.kind === "custom" ? entry.name : (entry.name + "_custom");
            settingsPolicyLabel.value = entry.kind === "custom" ? entry.label : (entry.label + " Custom");
          }
        }

        function setPolicyStatus(message, kind) {
          if (!policyStatus) {
            return;
          }

          policyStatus.hidden = false;
          policyStatus.className = "settings-status" + (kind ? " " + kind : "");
          policyStatus.textContent = message;
        }

        function clearPolicyStatus() {
          if (!policyStatus) {
            return;
          }

          policyStatus.hidden = true;
          policyStatus.className = "settings-status";
          policyStatus.textContent = "";
        }

        function newDraftPolicy() {
          var baseEntry = findPolicyEntry(defaultPolicyRef) || combinedPolicies()[0];
          if (!baseEntry) {
            return;
          }

          try {
            var draft = JSON.parse(baseEntry.json);
            draft.meta = draft.meta || {};
            draft.meta.name = "custom_policy";
            draft.meta.label = "Custom Policy";
            draft.meta.source = "gui_policy";
            settingsPolicyRef.value = baseEntry.id;
            settingsPolicyName.value = "custom_policy";
            settingsPolicyLabel.value = "Custom Policy";
            settingsPolicyJson.value = JSON.stringify(draft, null, 2);
            clearPolicyStatus();
          } catch (_error) {
            setPolicyStatus("Could not initialize a new policy draft from the default baseline.", "error");
          }
        }

        function saveCurrentPolicy() {
          clearPolicyStatus();

          var payload = new URLSearchParams();
          payload.set("policy_name", settingsPolicyName.value);
          payload.set("policy_label", settingsPolicyLabel.value);
          payload.set("policy_json", settingsPolicyJson.value);

          fetch("/validate-policy", {
            method: "POST",
            headers: {
              "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
            },
            body: payload.toString()
          }).then(function (response) {
            return response.json().then(function (data) {
              return { ok: response.ok, data: data };
            });
          }).then(function (result) {
            if (!result.ok || result.data.status !== "ok") {
              throw new Error(result.data.error || "Policy validation failed.");
            }

            var ref = "custom:" + result.data.policy_name;
            var customPolicies = loadCustomPolicies();
            customPolicies[ref] = {
              id: ref,
              kind: "custom",
              name: result.data.policy_name,
              label: result.data.policy_label,
              description: "Saved from GUI settings",
              source: "gui_policy",
              json: result.data.pretty_json
            };
            persistCustomPolicies(customPolicies);

            settingsPolicyJson.value = result.data.pretty_json;
            settingsPolicyRef.value = ref;
            settingsPolicyName.value = result.data.policy_name;
            settingsPolicyLabel.value = result.data.policy_label;

            populatePolicySelect(settingsPolicyRef, ref);
            populatePolicySelect(analysisPolicyRef, ref);
            if (analysisPolicyRef) {
              analysisPolicyRef.value = ref;
            }
            updateAnalysisPolicyState();
            setPolicyStatus("Custom policy saved and added to the analysis selector.", "success");
          }).catch(function (error) {
            setPolicyStatus(error.message, "error");
          });
        }

        function deleteCurrentPolicy() {
          clearPolicyStatus();

          var ref = settingsPolicyRef ? settingsPolicyRef.value : "";
          if (!ref || ref.indexOf("custom:") !== 0) {
            setPolicyStatus("Select a custom policy before deleting it.", "error");
            return;
          }

          var customPolicies = loadCustomPolicies();
          delete customPolicies[ref];
          persistCustomPolicies(customPolicies);

          populatePolicySelect(settingsPolicyRef, defaultPolicyRef);
          populatePolicySelect(analysisPolicyRef, defaultPolicyRef);
          if (analysisPolicyRef) {
            analysisPolicyRef.value = defaultPolicyRef;
          }
          applyPolicyToSettings(defaultPolicyRef);
          updateAnalysisPolicyState();
          setPolicyStatus("Custom policy deleted from browser storage.", "success");
        }

        if (settingsPolicyRef) {
          settingsPolicyRef.addEventListener("change", function () {
            applyPolicyToSettings(settingsPolicyRef.value);
            clearPolicyStatus();
          });
        }

        if (analysisPolicyRef) {
          analysisPolicyRef.addEventListener("change", updateAnalysisPolicyState);
        }

        if (policyNewButton) {
          policyNewButton.addEventListener("click", newDraftPolicy);
        }

        if (policyCloneButton) {
          policyCloneButton.addEventListener("click", function () {
            applyPolicyToSettings(settingsPolicyRef.value || defaultPolicyRef);
            clearPolicyStatus();
          });
        }

        if (policySaveButton) {
          policySaveButton.addEventListener("click", saveCurrentPolicy);
        }

        if (policyDeleteButton) {
          policyDeleteButton.addEventListener("click", deleteCurrentPolicy);
        }

        if (resetAnalysisButton) {
          resetAnalysisButton.addEventListener("click", function () {
            analysisForm.reset();
            if (analysisPolicyRef) {
              analysisPolicyRef.value = defaultPolicyRef;
            }
            if (analysisPolicyJson) {
              analysisPolicyJson.value = "";
            }
            updateAnalysisPolicyState();
          });
        }

        if (analysisForm) {
          analysisForm.addEventListener("submit", function () {
            if (!analysisPolicyRef || !analysisPolicyJson) {
              return;
            }

            var entry = findPolicyEntry(analysisPolicyRef.value);
            if (entry && entry.kind === "custom") {
              analysisPolicyJson.value = entry.json;
            } else {
              analysisPolicyJson.value = "";
            }
          });
        }

        populatePolicySelect(settingsPolicyRef, defaultPolicyRef);
        populatePolicySelect(analysisPolicyRef, defaultPolicyRef);
        applyPolicyToSettings(defaultPolicyRef);
        if (analysisPolicyRef) {
          analysisPolicyRef.value = defaultPolicyRef;
        }
        updateAnalysisPolicyState();

        if (customPolicyLocked && analysisPolicyRef) {
          analysisPolicyRef.value = defaultPolicyRef;
        }

        activateWorkspaceTab("analyze");
      })();
    </script>
  </body>
</html>
