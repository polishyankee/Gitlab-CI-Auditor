<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>GitLab CI SSDLC Report</title>
    <style>
      :root {
        --bg: #0e1016;
        --bg-accent: #05070d;
        --panel: #151821;
        --panel-soft: #10131b;
        --border: #2f3442;
        --border-strong: #444d60;
        --ink: #dce3ea;
        --muted: #99a4b3;
        --orange: #fc6d26;
        --orange-strong: #e24329;
        --orange-soft: rgba(252, 109, 38, 0.16);
        --orange-soft-strong: rgba(252, 109, 38, 0.28);
        --amber: #fca326;
        --green: #2ea043;
        --blue: #7cb4ff;
        --red: #f85149;
        --yellow: #d7a33e;
        --violet: #8957e5;
        --shadow: 0 28px 80px rgba(0, 0, 0, 0.45);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(252, 109, 38, 0.18), transparent 24%),
          radial-gradient(circle at top right, rgba(226, 67, 41, 0.16), transparent 20%),
          linear-gradient(180deg, #151821, #0a0d14);
        font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(18px);
        background: rgba(14, 16, 22, 0.88);
        border-bottom: 1px solid rgba(68, 77, 96, 0.5);
      }

      .topbar-inner,
      main {
        max-width: 1280px;
        margin: 0 auto;
        padding-left: 24px;
        padding-right: 24px;
      }

      .topbar-inner {
        min-height: 66px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .repo-strip {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
      }

      .pill,
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 7px 12px;
        border: 1px solid var(--orange-soft-strong);
        background: var(--orange-soft);
        color: #ffd7bf;
        font-size: 0.82rem;
      }

      .badge {
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .pass { color: #8ef0a5; background: rgba(63, 185, 80, 0.16); border-color: rgba(63, 185, 80, 0.28); }
      .warn { color: #ffd27c; background: rgba(215, 163, 62, 0.16); border-color: rgba(215, 163, 62, 0.28); }
      .fail { color: #ffaea9; background: rgba(248, 81, 73, 0.14); border-color: rgba(248, 81, 73, 0.28); }
      .review { color: #d0b0ff; background: rgba(163, 113, 247, 0.14); border-color: rgba(163, 113, 247, 0.28); }
      .skipped { color: #a8b2bf; background: rgba(153, 164, 179, 0.12); border-color: rgba(153, 164, 179, 0.18); }
      .disabled { color: #b7d6ff; background: rgba(124, 180, 255, 0.14); border-color: rgba(124, 180, 255, 0.26); }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }

      .brand svg {
        width: 24px;
        height: 24px;
        display: block;
      }

      main {
        padding-top: 34px;
        padding-bottom: 88px;
      }

      .hero,
      .section {
        background: linear-gradient(180deg, rgba(21, 24, 33, 0.96), rgba(9, 11, 16, 0.98));
        border: 1px solid var(--border);
        border-radius: 28px;
        box-shadow: var(--shadow);
      }

      .hero {
        padding: 36px;
        display: grid;
        gap: 28px;
        grid-template-columns: 1fr;
        align-items: start;
      }

      h1,
      h2,
      h3 {
        margin: 0;
      }

      .hero h1 {
        margin-top: 16px;
        font-size: clamp(2.8rem, 4.8vw, 4.8rem);
        line-height: 0.92;
        letter-spacing: -0.04em;
        color: #f8fafc;
      }

      .muted {
        color: var(--muted);
      }

      .hero-copy p {
        margin: 12px 0 0;
        line-height: 1.7;
        max-width: 72ch;
      }

      .hero-mark {
        display: flex;
        gap: 22px;
        align-items: flex-start;
        flex-wrap: wrap;
      }

      .hero-logo {
        width: 98px;
        height: 98px;
        flex: none;
        filter: drop-shadow(0 14px 26px rgba(252, 109, 38, 0.2));
      }

      .brand-row {
        margin-top: 22px;
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .brand-card {
        min-width: 152px;
        padding: 18px;
        border-radius: 18px;
        border: 1px solid var(--border);
        background: linear-gradient(180deg, rgba(252, 109, 38, 0.07), rgba(255, 255, 255, 0.02));
      }

      .brand-card strong {
        display: block;
        margin-top: 10px;
        color: #fff3eb;
      }

      .brand-card span {
        display: block;
        margin-top: 6px;
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.5;
      }

      .score {
        padding: 24px;
        border-radius: 20px;
        border: 1px solid var(--border);
        background: linear-gradient(180deg, rgba(252, 109, 38, 0.12), rgba(9, 11, 16, 0.96));
      }

      .score-row .score {
        display: grid;
        gap: 18px;
        grid-template-columns: 1fr;
        align-items: start;
      }

      .score-top {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        align-items: flex-end;
        flex-wrap: wrap;
      }

      .score-main {
        min-width: 0;
      }

      .score-side {
        display: grid;
        gap: 12px;
        justify-items: start;
      }

      .score-value {
        display: block;
        margin-top: 10px;
        font-size: 4rem;
        line-height: 0.95;
        color: #f8fafc;
      }

      .score-meta {
        display: grid;
        gap: 12px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .score-meta-card {
        padding: 14px 16px;
        border-radius: 16px;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.03);
      }

      .score-meta-card strong {
        display: block;
        margin-top: 8px;
        color: #fff3eb;
        font-size: 1rem;
        line-height: 1.45;
        word-break: break-word;
      }

      .score-row,
      .metric-grid,
      .diff-grid,
      .legend-grid,
      .category-grid,
      .controls {
        display: grid;
        gap: 16px;
      }

      .score-row {
        margin-top: 22px;
        grid-template-columns: 1fr;
      }

      .metric-grid {
        margin-top: 16px;
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      .diff-grid,
      .legend-grid {
        margin-top: 16px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .card {
        padding: 18px;
        border-radius: 18px;
        border: 1px solid var(--border);
        background: linear-gradient(180deg, rgba(252, 109, 38, 0.07), rgba(255, 255, 255, 0.02));
      }

      .card strong {
        display: block;
        margin: 10px 0 6px;
        color: #f0f6fc;
        font-size: 1.45rem;
      }

      .legend-card,
      .diff-card {
        padding: 18px;
        border-radius: 18px;
        border: 1px solid var(--border);
        background: linear-gradient(180deg, rgba(252, 109, 38, 0.07), rgba(255, 255, 255, 0.02));
      }

      .legend-card strong,
      .diff-card strong {
        display: block;
        margin: 10px 0 6px;
        color: #fff3eb;
      }

      .section {
        margin-top: 22px;
        padding: 30px 32px;
      }

      .graph-panel {
        position: relative;
        left: 50%;
        width: calc(100vw - 32px);
        margin-left: calc(-50vw + 16px);
      }

      .benchmark-panel {
        position: relative;
        left: 50%;
        width: calc(100vw - 32px);
        margin-left: calc(-50vw + 16px);
      }

      .tabbar {
        margin-top: 22px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      .tab-btn {
        border: 1px solid var(--border);
        border-radius: 12px;
        background: rgba(252, 109, 38, 0.06);
        color: var(--muted);
        padding: 10px 14px;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
      }

      .tab-btn.active {
        color: #fff3eb;
        background: rgba(252, 109, 38, 0.16);
        border-color: rgba(252, 109, 38, 0.42);
      }

      .tab-panel[hidden] {
        display: none;
      }

      .category-grid {
        margin-top: 16px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .benchmark-grid {
        margin-top: 16px;
        display: grid;
        gap: 16px;
        grid-template-columns: 1fr;
      }

      .meter {
        height: 10px;
        border-radius: 999px;
        background: rgba(110, 118, 129, 0.18);
        overflow: hidden;
        margin: 14px 0;
      }

      .meter span {
        display: block;
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--orange), var(--amber));
      }

      .list {
        display: grid;
        gap: 12px;
        margin-top: 16px;
      }

      .list-item,
      details {
        border: 1px solid var(--border);
        border-radius: 18px;
        background: linear-gradient(180deg, rgba(252, 109, 38, 0.05), rgba(255, 255, 255, 0.02));
      }

      .list-item {
        padding: 16px;
      }

      .finding-head {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
      }

      .finding-copy {
        margin-top: 10px;
        color: var(--muted);
        line-height: 1.65;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .finding-copy strong {
        color: var(--ink);
      }

      .benchmark-card {
        max-width: 100%;
      }

      .benchmark-card h3,
      .benchmark-card strong,
      .benchmark-card a {
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .benchmark-head,
      .benchmark-subhead {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
        flex-wrap: wrap;
      }

      .benchmark-head .badge,
      .benchmark-subhead .badge {
        flex-shrink: 0;
      }

      .benchmark-card h3 {
        margin: 0;
        font-size: 1.1rem;
        line-height: 1.35;
      }

      .benchmark-card > strong {
        font-size: 1.2rem;
        line-height: 1.3;
      }

      .benchmark-card .list-item strong {
        font-size: 0.98rem;
        line-height: 1.45;
        margin: 0;
      }

      .benchmark-link {
        color: #ffb088;
        display: inline-block;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      details {
        padding: 16px;
      }

      summary {
        cursor: pointer;
        font-weight: 700;
        color: #f8fafc;
      }

      .controls {
        margin-top: 14px;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .control {
        padding: 14px;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: rgba(1, 4, 9, 0.24);
      }

      .job-pills {
        margin-top: 14px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .job-pill,
      .mini-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 7px 10px;
        border: 1px solid var(--border);
        font-size: 0.82rem;
      }

      .job-pill {
        background: rgba(252, 109, 38, 0.1);
        color: #ffe3d1;
      }

      .mini-pill {
        background: rgba(110, 118, 129, 0.08);
        color: var(--muted);
      }

      .graph-shell {
        position: relative;
        margin-top: 18px;
        border: 1px solid var(--border);
        border-radius: 22px;
        background: linear-gradient(180deg, rgba(16, 19, 27, 0.98), rgba(10, 13, 20, 0.98));
        overflow: auto;
      }

      .graph-canvas {
        position: relative;
        min-width: 100%;
        min-height: 460px;
      }

      .graph-svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        overflow: visible;
      }

      .graph-board {
        position: relative;
        display: grid;
        gap: 20px;
        padding: 24px;
        align-items: start;
      }

      .graph-column {
        position: relative;
        min-width: 320px;
      }

      .graph-stage {
        position: sticky;
        top: 0;
        z-index: 2;
        padding: 12px 14px;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: rgba(21, 24, 33, 0.94);
        color: #f8fafc;
        font-weight: 700;
      }

      .graph-lane {
        margin-top: 14px;
        display: grid;
        gap: 12px;
      }

      .graph-node {
        position: relative;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: linear-gradient(180deg, rgba(252, 109, 38, 0.05), rgba(255, 255, 255, 0.015));
        padding: 14px;
        min-height: 108px;
        transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease;
      }

      .graph-node:hover {
        transform: translateY(-2px);
        border-color: rgba(252, 109, 38, 0.42);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
      }

      .graph-node.good {
        border-color: rgba(63, 185, 80, 0.42);
        background: rgba(46, 160, 67, 0.08);
      }

      .graph-node.mixed {
        border-color: rgba(210, 153, 34, 0.42);
        background: rgba(210, 153, 34, 0.09);
      }

      .graph-node.risk {
        border-color: rgba(248, 81, 73, 0.42);
        background: rgba(248, 81, 73, 0.08);
      }

      .graph-node.trigger {
        border-color: rgba(137, 87, 229, 0.42);
        background: rgba(137, 87, 229, 0.09);
      }

      .graph-node.neutral {
        border-color: rgba(252, 109, 38, 0.22);
      }

      .graph-node h3 {
        margin: 0 0 8px;
        font-size: 1rem;
        line-height: 1.35;
        color: #f8fafc;
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .graph-node small {
        display: block;
        line-height: 1.45;
        color: var(--muted);
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .graph-badges {
        margin-top: 10px;
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
      }

      .graph-chip {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 4px 8px;
        background: rgba(252, 109, 38, 0.12);
        border: 1px solid rgba(252, 109, 38, 0.18);
        color: #ffe3d1;
        font-size: 0.75rem;
      }

      .graph-overlay-row {
        margin-top: 10px;
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
      }

      .graph-overlay-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 3px 8px;
        border: 1px solid var(--border);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
      }

      .graph-overlay-badge.blocking {
        background: rgba(46, 160, 67, 0.12);
        border-color: rgba(46, 160, 67, 0.28);
        color: #8ef0a5;
      }

      .graph-overlay-badge.optional {
        background: rgba(215, 163, 62, 0.12);
        border-color: rgba(215, 163, 62, 0.28);
        color: #ffd27c;
      }

      .graph-overlay-badge.manual {
        background: rgba(248, 81, 73, 0.12);
        border-color: rgba(248, 81, 73, 0.24);
        color: #ffaea9;
      }

      .graph-overlay-badge.trigger {
        background: rgba(137, 87, 229, 0.12);
        border-color: rgba(137, 87, 229, 0.24);
        color: #d0b0ff;
      }

      .graph-overlay-badge.critical {
        background: rgba(252, 109, 38, 0.16);
        border-color: rgba(252, 109, 38, 0.35);
        color: #ffd7bf;
      }

      .graph-empty {
        padding: 14px;
        border: 1px dashed var(--border);
        border-radius: 14px;
        color: var(--muted);
      }

      .graph-tooltip {
        position: fixed;
        z-index: 40;
        width: min(360px, calc(100vw - 24px));
        border: 1px solid var(--border-strong);
        border-radius: 16px;
        background: rgba(21, 24, 33, 0.98);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        padding: 14px;
        pointer-events: none;
      }

      .graph-tooltip h4 {
        margin: 0 0 8px;
        color: #f8fafc;
      }

      .graph-tooltip .tooltip-section {
        margin-top: 10px;
        color: var(--muted);
        line-height: 1.55;
        font-size: 0.92rem;
      }

      .graph-tooltip ul {
        margin: 8px 0 0 18px;
        padding: 0;
      }

      @supports (-webkit-line-clamp: 2) {
        .graph-node h3,
        .graph-node small {
          display: -webkit-box;
          -webkit-box-orient: vertical;
          overflow: hidden;
        }

        .graph-node h3 {
          -webkit-line-clamp: 2;
        }

        .graph-node small {
          -webkit-line-clamp: 2;
        }
      }

      .edge-needs {
        stroke: rgba(252, 109, 38, 0.58);
        stroke-width: 2;
        fill: none;
      }

      .edge-trigger {
        stroke: rgba(137, 87, 229, 0.66);
        stroke-width: 2;
        fill: none;
        stroke-dasharray: 6 5;
      }

      .edge-context {
        stroke: rgba(88, 166, 255, 0.72);
        stroke-width: 2;
        fill: none;
        stroke-dasharray: 2 8;
      }

      .edge-critical {
        stroke: rgba(252, 109, 38, 0.92);
        stroke-width: 3;
      }

      .graph-node.critical-path {
        box-shadow: 0 0 0 1px rgba(252, 109, 38, 0.42), 0 18px 40px rgba(252, 109, 38, 0.12);
      }

      .legend-swatch,
      .edge-swatch {
        display: inline-flex;
        width: 42px;
        height: 12px;
        border-radius: 999px;
        flex: none;
      }

      .legend-swatch.good { background: rgba(46, 160, 67, 0.3); border: 1px solid rgba(46, 160, 67, 0.5); }
      .legend-swatch.mixed { background: rgba(215, 163, 62, 0.28); border: 1px solid rgba(215, 163, 62, 0.5); }
      .legend-swatch.risk { background: rgba(248, 81, 73, 0.26); border: 1px solid rgba(248, 81, 73, 0.45); }
      .legend-swatch.trigger { background: rgba(137, 87, 229, 0.24); border: 1px solid rgba(137, 87, 229, 0.45); }

      .edge-swatch.needs { background: rgba(252, 109, 38, 0.42); }
      .edge-swatch.trigger { background: linear-gradient(90deg, rgba(137, 87, 229, 0.7), rgba(137, 87, 229, 0.25)); }
      .edge-swatch.context { background: linear-gradient(90deg, rgba(124, 180, 255, 0.7), rgba(124, 180, 255, 0.2)); }
      .edge-swatch.critical { background: linear-gradient(90deg, rgba(252, 109, 38, 0.95), rgba(252, 163, 38, 0.4)); }

      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.93em;
      }

      @media (max-width: 1120px) {
        .metric-grid,
        .diff-grid,
        .legend-grid,
        .category-grid,
        .controls,
        .benchmark-grid {
          grid-template-columns: 1fr;
        }

        .brand-row {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 760px) {
        .hero,
        .section {
          padding: 24px;
        }

        .hero-logo {
          width: 82px;
          height: 82px;
        }

        .score-value {
          font-size: 3.2rem;
        }

        .score-meta {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <div class="repo-strip">
          <span class="brand pill">
            <svg viewBox="0 0 128 128" aria-hidden="true">
              <polygon fill="#e24329" points="64,110 88,36 40,36"/>
              <polygon fill="#fc6d26" points="64,110 24,36 40,36"/>
              <polygon fill="#fc6d26" points="64,110 104,36 88,36"/>
              <polygon fill="#fca326" points="24,36 12,68 40,36"/>
              <polygon fill="#fca326" points="104,36 116,68 88,36"/>
              <polygon fill="#e24329" points="12,68 64,110 24,36"/>
              <polygon fill="#e24329" points="116,68 64,110 104,36"/>
              <polygon fill="#fc6d26" points="40,36 64,18 88,36 64,110"/>
            </svg>
            GitLab Report
          </span>
          <span class="pill"><code><%= ERB::Util.html_escape(@report[:pipeline_path]) %></code></span>
          <span class="pill">Policy Pack: <strong><%= ERB::Util.html_escape(@report[:summary][:policy_pack_label]) %></strong></span>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <div class="hero-mark">
            <svg class="hero-logo" viewBox="0 0 128 128" aria-hidden="true">
              <polygon fill="#e24329" points="64,110 88,36 40,36"/>
              <polygon fill="#fc6d26" points="64,110 24,36 40,36"/>
              <polygon fill="#fc6d26" points="64,110 104,36 88,36"/>
              <polygon fill="#fca326" points="24,36 12,68 40,36"/>
              <polygon fill="#fca326" points="104,36 116,68 88,36"/>
              <polygon fill="#e24329" points="12,68 64,110 24,36"/>
              <polygon fill="#e24329" points="116,68 64,110 104,36"/>
              <polygon fill="#fc6d26" points="40,36 64,18 88,36 64,110"/>
            </svg>
            <div>
              <span class="badge <%= @report[:summary][:status] == 'strong' ? 'pass' : (@report[:summary][:status] == 'acceptable' ? 'warn' : 'fail') %>">
                <%= @report[:summary][:status].tr("_", " ") %>
              </span>
              <h1>SSDLC report for <code><%= ERB::Util.html_escape(File.basename(@report[:pipeline_path])) %></code></h1>
              <p class="muted">
                Analysis generated <%= @report[:generated_at] %>. Active scenarios:
                <strong><%= @report[:summary][:active_scenarios] %></strong>,
                skipped:
                <strong><%= @report[:summary][:skipped_scenarios] %></strong>,
                scope:
                <strong><%= @report[:summary][:analysis_scope] %></strong>.
              </p>
            </div>
          </div>

          <div class="brand-row">
            <div class="brand-card">
              <span>Root + Include + Trigger</span>
              <strong><%= @report[:summary][:total_pipeline_files] %> pipeline files</strong>
              <span>The full local CI graph was collected into one shared analysis scope.</span>
            </div>
            <div class="brand-card">
              <span>Policy Remediation</span>
              <strong><%= @report[:ssdlc_findings].size %> findings</strong>
              <span>Each gap includes the issue, the recommendation, and a remediation direction.</span>
            </div>
          </div>

          <div class="score-row">
            <article class="score">
              <div class="score-top">
                <div class="score-main">
                  <span class="muted">Overall Score</span>
                  <div class="score-value"><%= @report[:summary][:overall_score] %>/<%= @report[:summary][:max_score] %></div>
                </div>
                <div class="score-side">
                  <div class="badge <%= @report[:summary][:status] == 'strong' ? 'pass' : (@report[:summary][:status] == 'acceptable' ? 'warn' : 'fail') %>" style="width: fit-content;">
                    Grade <%= @report[:summary][:grade] %>
                  </div>
                </div>
              </div>
              <div class="score-meta">
                <div class="score-meta-card">
                  <span class="muted">Policy</span>
                  <strong><%= @report[:summary][:policy_pack_label] %> (<%= @report[:summary][:policy_source] %>)</strong>
                </div>
                <div class="score-meta-card">
                  <span class="muted">Scope</span>
                  <strong><%= @report[:summary][:analysis_scope] %></strong>
                </div>
              </div>
            </article>
          </div>

          <div class="metric-grid">
            <article class="card">
              <span class="muted">Jobs</span>
              <strong><%= @report[:summary][:total_jobs] %></strong>
              <div class="muted">Across all discovered pipeline files</div>
            </article>
            <article class="card">
              <span class="muted">Stages</span>
              <strong><%= @report[:summary][:total_stages] %></strong>
              <div class="muted">After combining root and child pipelines</div>
            </article>
            <article class="card">
              <span class="muted">Resolved Downstream</span>
              <strong><%= @report[:summary][:resolved_downstream_pipelines] %></strong>
              <div class="muted">Local child or downstream pipelines loaded</div>
            </article>
            <article class="card">
              <span class="muted">Unresolved</span>
              <strong><%= @report[:summary][:unresolved_downstream_pipelines] %></strong>
              <div class="muted">Triggers outside the current analysis scope</div>
            </article>
            <article class="card">
              <span class="muted">Warnings</span>
              <strong><%= @report[:loader_warnings].size %></strong>
              <div class="muted">Parser and pipeline graph limitations</div>
            </article>
          </div>
        </div>
      </section>

      <div class="tabbar" role="tablist" aria-label="Report views">
        <button class="tab-btn active" data-tab="overview">Overview</button>
        <button class="tab-btn" data-tab="lint">Lint</button>
        <button class="tab-btn" data-tab="trends">Trends</button>
        <% if @report[:diff].is_a?(Hash) && @report[:diff][:enabled] %>
          <button class="tab-btn" data-tab="diff">Diff</button>
        <% end %>
        <button class="tab-btn" data-tab="benchmark">OWASP SAMM</button>
        <button class="tab-btn" data-tab="graph">Pipeline Graph</button>
        <button class="tab-btn" data-tab="ssdlc">SSDLC</button>
        <button class="tab-btn" data-tab="security">Security</button>
        <button class="tab-btn" data-tab="maintainability">Maintainability</button>
      </div>

      <section class="section tab-panel" data-panel="overview">
        <h2>Scoring Categories</h2>
        <div class="category-grid">
          <% @report[:categories].each do |category| %>
            <article class="card">
              <div style="display:flex; justify-content:space-between; gap:12px; align-items:center;">
                <h3><%= category[:title] %></h3>
                <span class="badge <%= category[:status] %>"><%= category[:status] %></span>
              </div>
              <div class="meter">
                <span style="width: <%= ((category[:score].to_f / category[:max_score]) * 100).round %>%"></span>
              </div>
              <strong><%= category[:score] %>/<%= category[:max_score] %></strong>
              <div class="muted"><%= category[:summary] %></div>
            </article>
          <% end %>
        </div>

        <div class="list">
          <div class="list-item">
            <strong>Global Recommendations</strong>
            <% if @report[:recommendations].empty? %>
              <div class="finding-copy">No critical recommendations.</div>
            <% else %>
              <div class="job-pills" style="margin-top:12px;">
                <% @report[:recommendations].each do |item| %>
                  <span class="mini-pill"><%= item %></span>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="list-item">
            <strong>Strengths</strong>
            <% if @report[:strengths].empty? %>
              <div class="finding-copy">No clear strengths were detected statically.</div>
            <% else %>
              <div class="job-pills" style="margin-top:12px;">
                <% @report[:strengths].each do |item| %>
                  <span class="mini-pill"><%= item %></span>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="list-item">
            <strong>Analysis Context</strong>
            <div class="finding-copy"><strong>Detected stacks:</strong> <%= Array(@report.dig(:metadata, :detected_stacks)).any? ? @report.dig(:metadata, :detected_stacks).join(", ") : "none detected" %></div>
            <div class="finding-copy"><strong>Template includes:</strong> <%= Array(@report.dig(:metadata, :template_includes)).any? ? @report.dig(:metadata, :template_includes).join(" | ") : "none detected" %></div>
            <% if @report.dig(:metadata, :context_manifest) %>
              <div class="finding-copy"><strong>Context manifest:</strong> <code><%= ERB::Util.html_escape(@report.dig(:metadata, :context_manifest)) %></code></div>
            <% end %>
            <% if Array(@report.dig(:metadata, :context_projects)).any? %>
              <div class="finding-copy"><strong>Context projects:</strong> <%= @report.dig(:metadata, :context_projects).join(", ") %></div>
            <% end %>
            <% if Array(@report.dig(:metadata, :resolved_project_includes)).any? %>
              <div class="finding-copy"><strong>Resolved project include snapshots:</strong> <%= @report.dig(:metadata, :resolved_project_includes).map { |item| item.is_a?(Hash) ? item["file"] || item[:file] : item }.join(" | ") %></div>
            <% end %>
          </div>
        </div>
      </section>

      <section class="section tab-panel" data-panel="lint" hidden>
        <h2>Lint and Best Practices</h2>
        <% lint = @report[:lint] || {} %>
        <div class="category-grid">
          <article class="card">
            <span class="muted">Lint Status</span>
            <strong><%= lint[:status] || "n/a" %></strong>
            <div class="badge <%= lint[:status] || "skipped" %>" style="margin-top: 12px; width: fit-content;"><%= lint[:status] || "n/a" %></div>
            <div class="muted" style="margin-top: 12px;"><%= lint[:summary] || "No lint summary available." %></div>
          </article>
          <article class="card">
            <span class="muted">Best-Practice Guidance</span>
            <strong><%= @report[:recommendations].size %></strong>
            <div class="muted">Global SSDLC and quality recommendations generated for this pipeline.</div>
          </article>
        </div>

        <div class="list">
          <div class="list-item">
            <strong>Lint Findings</strong>
            <% if Array(lint[:findings]).empty? %>
              <div class="finding-copy">No structural lint findings were detected.</div>
            <% else %>
              <% Array(lint[:findings]).each do |finding| %>
                <div class="finding-copy">
                  <span class="badge <%= finding[:status] %>"><%= finding[:status] %></span>
                  <strong><%= finding[:message] %></strong>
                  <% if Array(finding[:evidence]).any? %>
                    <div class="finding-copy"><%= Array(finding[:evidence]).join(" | ") %></div>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>

          <div class="list-item">
            <strong>Loader Warnings</strong>
            <% if @report[:loader_warnings].empty? %>
              <div class="finding-copy">No parser or loader warnings were emitted.</div>
            <% else %>
              <div class="job-pills" style="margin-top:12px;">
                <% @report[:loader_warnings].each do |warning| %>
                  <span class="mini-pill"><%= warning %></span>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="list-item">
            <strong>Best-Practice Recommendations</strong>
            <% if @report[:recommendations].empty? %>
              <div class="finding-copy">No global best-practice recommendations were generated.</div>
            <% else %>
              <div class="job-pills" style="margin-top:12px;">
                <% @report[:recommendations].each do |item| %>
                  <span class="mini-pill"><%= item %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </section>

      <section class="section tab-panel" data-panel="trends" hidden>
        <h2>Historical Trend Dashboard</h2>
        <% history = @report[:history] || {} %>
        <% if history[:enabled] %>
          <div class="category-grid">
            <article class="card">
              <span class="muted">History File</span>
              <strong><%= ERB::Util.html_escape(history[:path].to_s) %></strong>
              <div class="muted">Persistent JSON store used for score tracking</div>
            </article>
            <article class="card">
              <span class="muted">Stored Runs</span>
              <strong><%= history[:total_runs] %></strong>
              <div class="muted">Total scans currently recorded</div>
            </article>
            <article class="card">
              <span class="muted">Previous Score</span>
              <strong><%= history[:previous_score] || "n/a" %></strong>
              <div class="muted">Most recent score before this report</div>
            </article>
            <article class="card">
              <span class="muted">Score Delta</span>
              <strong><%= history[:score_delta] || "n/a" %></strong>
              <div class="muted">Difference versus the previous stored scan</div>
            </article>
          </div>

          <div class="list">
            <div class="list-item">
              <strong>Recent Runs</strong>
              <% if Array(history[:recent_runs]).empty? %>
                <div class="finding-copy">No previous scans are available yet.</div>
              <% else %>
                <div class="job-pills" style="margin-top:12px;">
                  <% history[:recent_runs].each do |run| %>
                    <span class="mini-pill"><%= "#{run[:generated_at]} · #{run[:overall_score]}/#{run[:max_score]} · #{run[:grade]} · #{run[:policy_pack_name]}" %></span>
                  <% end %>
                </div>
              <% end %>
            </div>

            <div class="list-item">
              <strong>Category Drift</strong>
              <% if Array(history[:category_deltas]).empty? %>
                <div class="finding-copy">No previous run is available for category comparison.</div>
              <% else %>
                <div class="job-pills" style="margin-top:12px;">
                  <% history[:category_deltas].each do |delta| %>
                    <span class="mini-pill"><%= "#{delta[:title]}: #{delta[:current_score]}/#{delta[:max_score]} (delta #{delta[:delta]})" %></span>
                  <% end %>
                </div>
              <% end %>
            </div>

            <div class="list-item">
              <strong>Benchmark Drift</strong>
              <% if Array(history[:benchmark_deltas]).empty? %>
                <div class="finding-copy">No previous run is available for benchmark comparison.</div>
              <% else %>
                <div class="job-pills" style="margin-top:12px;">
                  <% history[:benchmark_deltas].each do |delta| %>
                    <span class="mini-pill"><%= "#{delta[:title]}: #{delta[:current_score]}/100 (delta #{delta[:delta]})" %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="list">
            <div class="list-item">
              Historical trends are disabled for this report. Start the scan with a history store file to persist results and render score drift over time.
            </div>
          </div>
        <% end %>
      </section>

      <% if @report[:diff].is_a?(Hash) && @report[:diff][:enabled] %>
        <% diff = @report[:diff] %>
        <section class="section tab-panel" data-panel="diff" hidden>
          <h2>Pipeline Revision Diff</h2>
          <div class="finding-copy">
            Comparing the current report against baseline <code><%= ERB::Util.html_escape(diff.dig(:baseline, :pipeline_path).to_s) %></code>.
          </div>

          <div class="diff-grid">
            <article class="diff-card">
              <span class="muted">Current Revision</span>
              <strong><%= diff.dig(:current, :score) %>/<%= diff.dig(:current, :max_score) %></strong>
              <div class="muted">Grade <%= diff.dig(:current, :grade) %> · <%= diff.dig(:current, :status) %></div>
            </article>
            <article class="diff-card">
              <span class="muted">Baseline Revision</span>
              <strong><%= diff.dig(:baseline, :score) %>/<%= diff.dig(:baseline, :max_score) %></strong>
              <div class="muted">Grade <%= diff.dig(:baseline, :grade) %> · <%= diff.dig(:baseline, :status) %></div>
            </article>
            <article class="diff-card">
              <span class="muted">Score Delta</span>
              <strong><%= diff[:score_delta] %></strong>
              <div class="muted">Current versus baseline overall score change</div>
            </article>
          </div>

          <div class="list">
            <div class="list-item">
              <strong>Diff Summary</strong>
              <div class="job-pills" style="margin-top:12px;">
                <% Array(diff[:highlights]).each do |item| %>
                  <span class="mini-pill"><%= item %></span>
                <% end %>
              </div>
            </div>

            <div class="list-item">
              <strong>Category Changes</strong>
              <div class="job-pills" style="margin-top:12px;">
                <% Array(diff[:category_deltas]).each do |delta| %>
                  <span class="mini-pill"><%= "#{delta[:title]}: #{delta[:baseline_score]} -> #{delta[:current_score]} (#{delta[:delta] >= 0 ? '+' : ''}#{delta[:delta]})" %></span>
                <% end %>
              </div>
            </div>

            <% diff.fetch(:finding_deltas, {}).each do |section, finding_delta| %>
              <div class="list-item">
                <strong><%= section.to_s.upcase %> Finding Changes</strong>
                <% if Array(finding_delta[:added]).empty? && Array(finding_delta[:resolved]).empty? && Array(finding_delta[:severity_changed]).empty? %>
                  <div class="finding-copy">No changes detected for this finding group.</div>
                <% else %>
                  <% if Array(finding_delta[:added]).any? %>
                    <div class="finding-copy"><strong>Added:</strong> <%= finding_delta[:added].map { |finding| "#{finding[:title]} [#{finding[:severity]}]" }.join(" | ") %></div>
                  <% end %>
                  <% if Array(finding_delta[:resolved]).any? %>
                    <div class="finding-copy"><strong>Resolved:</strong> <%= finding_delta[:resolved].map { |finding| "#{finding[:title]} [#{finding[:severity]}]" }.join(" | ") %></div>
                  <% end %>
                  <% if Array(finding_delta[:severity_changed]).any? %>
                    <div class="finding-copy"><strong>Severity changed:</strong> <%= finding_delta[:severity_changed].map { |finding| "#{finding[:title]} (#{finding[:baseline_severity]} -> #{finding[:current_severity]})" }.join(" | ") %></div>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>

      <section class="section tab-panel benchmark-panel" data-panel="benchmark" hidden>
        <h2>OWASP SAMM v2 Benchmark</h2>
        <div class="finding-copy">
          <%= @report.dig(:benchmarks, :owasp_samm_v2, :note) %>
        </div>

        <div class="list">
          <% @report.dig(:benchmarks, :owasp_samm_v2, :observed_signals).to_a.each do |signal_group| %>
            <div class="list-item">
              <strong><%= signal_group[:label] %></strong>
              <div class="job-pills" style="margin-top:12px;">
                <% signal_group[:values].to_a.each do |value| %>
                  <span class="mini-pill"><%= value %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="benchmark-grid">
          <% @report.dig(:benchmarks, :owasp_samm_v2, :practices).to_a.each do |practice| %>
            <article class="card benchmark-card">
              <div class="benchmark-head">
                <h3><%= practice[:title] %></h3>
                <span class="badge <%= practice[:status] %>"><%= practice[:status] %></span>
              </div>
              <div class="meter">
                <span style="width: <%= practice[:alignment_score] %>%"></span>
              </div>
              <strong>Level <%= practice[:estimated_level] %>/<%= practice[:max_level] %></strong>
              <div class="muted">Alignment <%= practice[:alignment_score] %>/100 · Confidence <%= practice[:confidence] %></div>
              <div class="finding-copy" style="margin-top:10px;"><strong>Rationale:</strong> <%= practice[:rationale] %></div>
              <div class="finding-copy" style="margin-top:10px;"><strong>Good signals:</strong> <%= practice[:good_signals].any? ? practice[:good_signals].join(" | ") : "No strong signals detected" %></div>
              <div class="finding-copy" style="margin-top:10px;"><strong>Gaps:</strong> <%= practice[:gaps].any? ? practice[:gaps].join(" | ") : "No significant gaps detected from the pipeline definition" %></div>
              <div class="finding-copy" style="margin-top:10px;"><strong>OWASP SAMM rules:</strong></div>
              <div class="list" style="margin-top:10px;">
                <% practice[:rules].to_a.each do |rule| %>
                  <div class="list-item">
                    <div class="benchmark-subhead">
                      <strong><%= rule[:title] %></strong>
                      <span class="badge <%= rule[:status] %>"><%= rule[:status] %></span>
                    </div>
                    <div class="finding-copy" style="margin-top:8px;"><%= rule[:detail] %></div>
                  </div>
                <% end %>
              </div>
              <div class="finding-copy" style="margin-top:10px;">
                <strong>Upstream question mapping:</strong>
                <% summary = practice[:question_summary] || {} %>
                <%= summary.fetch(:pass, 0) %> pass · <%= summary.fetch(:warn, 0) %> warn · <%= summary.fetch(:fail, 0) %> fail · <%= summary.fetch(:review, 0) %> review
              </div>
              <div class="list" style="margin-top:10px;">
                <% practice[:questions].to_a.each do |question| %>
                  <div class="list-item">
                    <div class="benchmark-subhead">
                      <strong><%= question[:key] %> · <%= question[:title] %></strong>
                      <span class="badge <%= question[:status] %>"><%= question[:status] %></span>
                    </div>
                    <div class="finding-copy" style="margin-top:8px;"><strong>Observability:</strong> <%= question[:observability] %></div>
                    <div class="finding-copy" style="margin-top:8px;"><%= question[:detail] %></div>
                    <% if question[:recommendation] %>
                      <div class="finding-copy" style="margin-top:8px;"><strong>How to improve:</strong> <%= question[:recommendation] %></div>
                    <% end %>
                    <div class="finding-copy" style="margin-top:8px;"><strong>Static limits:</strong> <%= question[:static_limitations] %></div>
                    <div class="finding-copy" style="margin-top:8px;">
                      <strong>Source:</strong>
                      <a class="benchmark-link" href="<%= question[:source_url] %>" target="_blank" rel="noreferrer"><%= question[:source_url] %></a>
                    </div>
                  </div>
                <% end %>
              </div>
              <div class="finding-copy" style="margin-top:10px;">
                <strong>Reference:</strong>
                <a class="benchmark-link" href="<%= practice[:reference_url] %>" target="_blank" rel="noreferrer"><%= practice[:reference_url] %></a>
              </div>
            </article>
          <% end %>
        </div>
      </section>

      <section class="section tab-panel graph-panel" data-panel="graph" hidden>
        <h2>Pipeline Flow Graph</h2>
        <div class="finding-copy">
          Columns represent stages, edges show dependency flow, and overlay badges identify whether a control behaves as a blocking gate, an optional gate, or a manual gate.
          Hover over a job to inspect weak spots, strengths, and critical-path placement.
        </div>

        <% if @report.dig(:graph, :critical_path, :labels).to_a.any? %>
          <div class="list" style="margin-top:16px;">
            <div class="list-item">
              <strong>Critical Path</strong>
              <div class="finding-copy">
                <%= @report.dig(:graph, :critical_path, :labels).join(" -> ") %>
              </div>
              <div class="finding-copy">
                Weighted path score: <%= @report.dig(:graph, :critical_path, :total_weight) %> · Pipelines: <%= @report.dig(:graph, :critical_path, :pipelines).join(", ") %>
              </div>
            </div>
          </div>
        <% end %>

        <div class="legend-grid">
          <% Array(@report.dig(:graph, :legend, :node_variants)).each do |item| %>
            <div class="legend-card">
              <span class="legend-swatch <%= item[:variant] %>"></span>
              <strong><%= item[:label] %></strong>
              <div class="muted"><%= item[:description] %></div>
            </div>
          <% end %>
          <% Array(@report.dig(:graph, :legend, :edge_variants)).each do |item| %>
            <div class="legend-card">
              <span class="edge-swatch <%= item[:edge_type] %>"></span>
              <strong><%= item[:label] %></strong>
              <div class="muted"><%= item[:description] %></div>
            </div>
          <% end %>
          <% Array(@report.dig(:graph, :legend, :gate_overlays)).each do |item| %>
            <div class="legend-card">
              <span class="graph-overlay-badge <%= item[:state] %>"><%= item[:label] %></span>
              <strong><%= item[:label] %></strong>
              <div class="muted"><%= item[:description] %></div>
            </div>
          <% end %>
        </div>

        <div class="graph-shell">
          <div class="graph-canvas" id="graph-canvas">
            <svg class="graph-svg" id="graph-svg"></svg>
            <div class="graph-board" id="graph-board"></div>
          </div>
        </div>
        <div class="graph-tooltip" id="graph-tooltip" hidden></div>
      </section>

      <section class="section tab-panel" data-panel="ssdlc" hidden>
        <h2>SSDLC Findings and Remediation</h2>
        <div class="list">
          <% if @report[:ssdlc_findings].empty? %>
            <div class="list-item">No material SSDLC gaps were detected statically.</div>
          <% else %>
            <% @report[:ssdlc_findings].each do |finding| %>
              <div class="list-item">
                <div class="finding-head">
                  <span class="badge <%= finding[:severity] == 'high' ? 'fail' : (finding[:severity] == 'medium' ? 'warn' : 'skipped') %>"><%= finding[:severity] %></span>
                  <strong><%= finding[:title] %></strong>
                </div>
                <div class="finding-copy"><strong>Issue:</strong> <%= finding[:issue] %></div>
                <% if finding[:evidence].any? %>
                  <div class="finding-copy"><strong>Evidence:</strong> <%= finding[:evidence].join(" | ") %></div>
                <% end %>
                <% if finding[:base_severity] && finding[:base_severity] != finding[:severity] %>
                  <div class="finding-copy"><strong>Severity policy:</strong> tuned from <%= finding[:base_severity] %> to <%= finding[:severity] %> by the selected organization policy.</div>
                <% end %>
                <% if finding[:recommendation] %>
                  <div class="finding-copy"><strong>Recommendation:</strong> <%= finding[:recommendation] %></div>
                <% end %>
                <% if finding[:how_to_fix] %>
                  <div class="finding-copy"><strong>How to fix:</strong> <%= finding[:how_to_fix] %></div>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>

        <div class="list">
          <% @report[:scenarios].each do |scenario| %>
            <details>
              <summary>
                <span class="badge <%= scenario[:status] %>"><%= scenario[:status] %></span>
                <%= scenario[:label] %>
              </summary>

              <% if scenario[:status] == "skipped" %>
                <p class="muted" style="margin: 12px 0 0;"><%= scenario[:reason] %></p>
              <% else %>
                <% if scenario[:changed_files].any? %>
                  <p class="muted" style="margin: 12px 0 0;"><strong>Changed files:</strong> <%= scenario[:changed_files].join(", ") %></p>
                <% end %>
                <% if scenario[:changes_context].is_a?(Hash) && scenario[:changes_context][:patterns].any? %>
                  <p class="muted" style="margin: 8px 0 0;"><strong>Matched change patterns:</strong> <%= scenario[:changes_context][:patterns].join(", ") %></p>
                <% end %>
                <div class="controls">
                  <% scenario[:controls].each do |key, state| %>
                    <div class="control">
                      <strong><%= key %></strong>
                      <div class="badge <%= state[:status] %>" style="margin-top:8px; width: fit-content;"><%= state[:status] %></div>
                      <% if state[:evidence].any? %>
                        <p class="muted" style="margin:10px 0 0;"><%= state[:evidence].join(", ") %></p>
                      <% end %>
                    </div>
                  <% end %>
                </div>

                <% if scenario[:downstream_warnings].any? %>
                  <p class="muted" style="margin-top: 14px;"><strong>Downstream warnings:</strong> <%= scenario[:downstream_warnings].join(" | ") %></p>
                <% end %>

                <div class="job-pills">
                  <% scenario[:jobs].each do |job| %>
                    <span class="job-pill"><%= job[:name] %> / <%= job[:stage] %> / <%= job[:pipeline_label] %></span>
                  <% end %>
                </div>
              <% end %>
            </details>
          <% end %>
        </div>
      </section>

      <section class="section tab-panel" data-panel="security" hidden>
        <h2>Security Policies</h2>
        <div class="list">
          <% if @report[:security_findings].empty? %>
            <div class="list-item">No material violations were detected by the default policy pack.</div>
          <% else %>
            <% @report[:security_findings].each do |finding| %>
              <div class="list-item">
                <div class="finding-head">
                  <span class="badge <%= finding[:severity] == 'high' ? 'fail' : (finding[:severity] == 'medium' ? 'warn' : 'skipped') %>"><%= finding[:severity] %></span>
                  <strong><%= finding[:title] %></strong>
                </div>
                <div class="finding-copy"><strong>Issue:</strong> <%= finding[:issue] %></div>
                <% if finding[:base_severity] && finding[:base_severity] != finding[:severity] %>
                  <div class="finding-copy"><strong>Severity policy:</strong> tuned from <%= finding[:base_severity] %> to <%= finding[:severity] %> by the selected organization policy.</div>
                <% end %>
                <% if finding[:recommendation] %>
                  <div class="finding-copy"><strong>Recommendation:</strong> <%= finding[:recommendation] %></div>
                <% end %>
                <% if finding[:how_to_fix] %>
                  <div class="finding-copy"><strong>How to fix:</strong> <%= finding[:how_to_fix] %></div>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>

      <section class="section tab-panel" data-panel="maintainability" hidden>
        <h2>Pipeline Maintainability</h2>
        <div class="list">
          <% if @report[:maintainability][:findings].empty? %>
            <div class="list-item">No material maintainability problems were detected.</div>
          <% else %>
            <% @report[:maintainability][:findings].each do |finding| %>
              <div class="list-item"><%= finding %></div>
            <% end %>
          <% end %>
        </div>
      </section>
    </main>

    <script id="graph-data" type="application/json"><%= JSON.generate(@report[:graph]).gsub("</", "<\\/") %></script>
    <script>
      (function () {
        var tabButtons = Array.prototype.slice.call(document.querySelectorAll(".tab-btn"));
        var panels = Array.prototype.slice.call(document.querySelectorAll(".tab-panel"));
        var graphRendered = false;
        var graphNodes = {};
        var graphData = {};

        function activateTab(name) {
          tabButtons.forEach(function (button) {
            button.classList.toggle("active", button.dataset.tab === name);
          });

          panels.forEach(function (panel) {
            var active = panel.dataset.panel === name;
            panel.hidden = !active;
          });

          if (name === "graph") {
            renderGraph();
            window.requestAnimationFrame(drawEdges);
          }
        }

        tabButtons.forEach(function (button) {
          button.addEventListener("click", function () {
            activateTab(button.dataset.tab);
          });
        });

        function escapeHtml(value) {
          return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
        }

        function tooltipList(title, items, emptyText) {
          if (!items || !items.length) {
            return '<div class="tooltip-section"><strong>' + title + ':</strong> ' + escapeHtml(emptyText) + "</div>";
          }

          return '<div class="tooltip-section"><strong>' + title + ':</strong><ul>' +
            items.map(function (item) { return "<li>" + escapeHtml(item) + "</li>"; }).join("") +
            "</ul></div>";
        }

        function gateOverlayMarkup(overlays, criticalPath) {
          var markup = (overlays || []).map(function (overlay) {
            return '<span class="graph-overlay-badge ' + escapeHtml(overlay.state || "blocking") + '">' + escapeHtml(overlay.label) + "</span>";
          }).join("");
          if (criticalPath) {
            markup += '<span class="graph-overlay-badge critical">CRITICAL</span>';
          }
          return markup;
        }

        function showTooltip(node, event) {
          var tooltip = document.getElementById("graph-tooltip");
          tooltip.hidden = false;
          tooltip.innerHTML =
            "<h4>" + escapeHtml(node.label) + "</h4>" +
            '<div class="tooltip-section"><strong>Pipeline:</strong> ' + escapeHtml(node.pipeline_label) + "</div>" +
            '<div class="tooltip-section"><strong>Stage:</strong> ' + escapeHtml(node.stage) + "</div>" +
            (node.critical_path ? '<div class="tooltip-section"><strong>Critical path:</strong> This node is part of the longest weighted delivery route.</div>' : "") +
            ((node.gate_overlays || []).length ? '<div class="tooltip-section"><strong>Gate overlays:</strong> ' + gateOverlayMarkup(node.gate_overlays, false) + "</div>" : "") +
            (node.environment ? '<div class="tooltip-section"><strong>Environment:</strong> ' + escapeHtml(node.environment) + "</div>" : "") +
            tooltipList("Strengths", node.strengths, "No clear positive signals") +
            tooltipList("Weak spots", node.weaknesses, "No obvious weak spots") +
            tooltipList("Notes", node.notes, "No additional notes");
          moveTooltip(event);
        }

        function moveTooltip(event) {
          var tooltip = document.getElementById("graph-tooltip");
          if (tooltip.hidden) {
            return;
          }

          var left = event.clientX + 18;
          var top = event.clientY + 18;
          var maxLeft = window.innerWidth - tooltip.offsetWidth - 12;
          var maxTop = window.innerHeight - tooltip.offsetHeight - 12;
          tooltip.style.left = Math.max(12, Math.min(left, maxLeft)) + "px";
          tooltip.style.top = Math.max(12, Math.min(top, maxTop)) + "px";
        }

        function hideTooltip() {
          var tooltip = document.getElementById("graph-tooltip");
          tooltip.hidden = true;
        }

        function renderGraph() {
          if (graphRendered) {
            return;
          }

          graphData = JSON.parse(document.getElementById("graph-data").textContent || "{}");
          var board = document.getElementById("graph-board");
          if (!board || !graphData.stages) {
            return;
          }

          board.innerHTML = "";
          board.style.gridTemplateColumns = "repeat(" + Math.max(graphData.stages.length, 1) + ", minmax(320px, 1fr))";

          var nodesByStage = {};
          (graphData.nodes || []).forEach(function (node) {
            if (!nodesByStage[node.stage]) {
              nodesByStage[node.stage] = [];
            }
            nodesByStage[node.stage].push(node);
            graphNodes[node.id] = node;
          });

          graphData.stages.forEach(function (stage) {
            var column = document.createElement("div");
            column.className = "graph-column";

            var stageHead = document.createElement("div");
            stageHead.className = "graph-stage";
            stageHead.textContent = stage;
            column.appendChild(stageHead);

            var lane = document.createElement("div");
            lane.className = "graph-lane";

            var stageNodes = (nodesByStage[stage] || []).sort(function (a, b) {
              if (a.pipeline_index !== b.pipeline_index) {
                return a.pipeline_index - b.pipeline_index;
              }
              return a.label.localeCompare(b.label);
            });

            if (!stageNodes.length) {
              var empty = document.createElement("div");
              empty.className = "graph-empty";
              empty.textContent = "No jobs in this stage";
              lane.appendChild(empty);
            } else {
              stageNodes.forEach(function (node) {
                var card = document.createElement("div");
                card.className = "graph-node " + (node.variant || "neutral") + (node.critical_path ? " critical-path" : "");
                card.dataset.nodeId = node.id;
                card.innerHTML =
                  "<h3>" + escapeHtml(node.label) + "</h3>" +
                  "<small>" + escapeHtml(node.pipeline_short_label || node.pipeline_label) + "</small>" +
                  '<div class="graph-overlay-row">' + gateOverlayMarkup(node.gate_overlays || [], node.critical_path) + "</div>" +
                  '<div class="graph-badges">' +
                    (node.classifications || []).slice(0, 4).map(function (item) {
                      return '<span class="graph-chip">' + escapeHtml(item) + "</span>";
                    }).join("") +
                  "</div>";

                card.addEventListener("mouseenter", function (event) { showTooltip(node, event); });
                card.addEventListener("mousemove", moveTooltip);
                card.addEventListener("mouseleave", hideTooltip);
                lane.appendChild(card);
              });
            }

            column.appendChild(lane);
            board.appendChild(column);
          });

          graphRendered = true;
        }

        function drawEdges() {
          if (!graphRendered) {
            return;
          }

          var board = document.getElementById("graph-board");
          var canvas = document.getElementById("graph-canvas");
          var svg = document.getElementById("graph-svg");
          if (!board || !canvas || !svg) {
            return;
          }

          var boardRect = board.getBoundingClientRect();
          var width = Math.max(board.scrollWidth, board.clientWidth);
          var height = Math.max(board.scrollHeight, board.clientHeight);
          canvas.style.width = width + "px";
          canvas.style.height = height + "px";
          svg.setAttribute("viewBox", "0 0 " + width + " " + height);
          svg.setAttribute("width", width);
          svg.setAttribute("height", height);
          svg.innerHTML = "";

          var positions = {};
          Array.prototype.slice.call(board.querySelectorAll(".graph-node")).forEach(function (element) {
            var rect = element.getBoundingClientRect();
            positions[element.dataset.nodeId] = {
              left: rect.left - boardRect.left,
              right: rect.right - boardRect.left,
              top: rect.top - boardRect.top,
              bottom: rect.bottom - boardRect.top,
              centerY: rect.top - boardRect.top + (rect.height / 2)
            };
          });

          (graphData.edges || []).forEach(function (edge) {
            var from = positions[edge.from];
            var to = positions[edge.to];
            if (!from || !to) {
              return;
            }

            var startX = from.right;
            var startY = from.centerY;
            var endX = to.left;
            var endY = to.centerY;
            var curve = Math.max(50, Math.abs(endX - startX) * 0.35);
            var path = document.createElementNS("http://www.w3.org/2000/svg", "path");
            path.setAttribute("d", "M " + startX + " " + startY + " C " + (startX + curve) + " " + startY + ", " + (endX - curve) + " " + endY + ", " + endX + " " + endY);
            var edgeClass = "edge-needs";
            if (edge.type === "trigger") {
              edgeClass = "edge-trigger";
            } else if (edge.type === "context") {
              edgeClass = "edge-context";
            }
            path.setAttribute("class", edgeClass);
            if (edge.critical_path) {
              path.setAttribute("class", edgeClass + " edge-critical");
            }
            svg.appendChild(path);
          });
        }

        window.addEventListener("resize", function () {
          if (!document.querySelector('[data-panel="graph"]').hidden) {
            window.requestAnimationFrame(drawEdges);
          }
        });

        activateTab("overview");
      })();
    </script>
  </body>
</html>
